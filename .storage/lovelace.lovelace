        {
          "type": "panel",
          "title": "Energy Cost",
          "path": "energy-cost",
          "cards": [
            {
              "type": "custom:plotly-graph",
              "title": "OMIE Spot Price & Charge Windows (48h)",
              "layout": {
                "legend": {
                  "orientation": "h",
                  "yanchor": "top",
                  "y": -0.05,
                  "xanchor": "center",
                  "x": 0.5
                },
                "xaxis": {
                  "tickformat": "%H:%M",
                  "range": [
                    "$fn () => new Date(new Date().setHours(0,0,0,0))",
                    "$fn () => new Date(new Date().setHours(23,59,59,999) + 86400000)"
                  ]
                },
                "yaxis2": {
                  "visible": false,
                  "fixedrange": true,
                  "range": [
                    0,
                    1
                  ],
                  "overlaying": "y"
                },
                "shapes": [
                  {
                    "type": "line",
                    "xref": "x",
                    "yref": "paper",
                    "x0": "$fn () => new Date()",
                    "x1": "$fn () => new Date()",
                    "y0": 0,
                    "y1": 1,
                    "line": {
                      "color": "white",
                      "width": 2,
                      "dash": "dash"
                    }
                  }
                ]
              },
              "entities": [
                {
                  "entity": "sensor.template_coopernico_spot_price_bihorario",
                  "name": "Today",
                  "line": {
                    "shape": "hv",
                    "color": "#FEB019"
                  },
                  "x": "$fn ({ hass }) => Object.keys(hass.states['sensor.template_coopernico_spot_price_bihorario']?.attributes.today_hours || {}).map(d => new Date(d))",
                  "y": "$fn ({ hass }) => Object.values(hass.states['sensor.template_coopernico_spot_price_bihorario']?.attributes.today_hours || {})"
                },
                {
                  "entity": "sensor.template_coopernico_spot_price_bihorario",
                  "name": "Tomorrow",
                  "line": {
                    "shape": "hv",
                    "color": "#008FFB"
                  },
                  "x": "$fn ({ hass }) => Object.keys(hass.states['sensor.template_coopernico_spot_price_bihorario']?.attributes.tomorrow_hours || {}).map(d => new Date(d))",
                  "y": "$fn ({ hass }) => Object.values(hass.states['sensor.template_coopernico_spot_price_bihorario']?.attributes.tomorrow_hours || {})"
                },
                {
                  "entity": "input_datetime.automation_ev2_charge_start",
                  "name": "EV Charge",
                  "yaxis": "y2",
                  "fill": "toself",
                  "mode": "lines",
                  "fillcolor": "rgba(0, 143, 251, 0.3)",
                  "line": {
                    "width": 0
                  },
                  "x": "$fn ({ hass }) => {\n  let s = hass.states['input_datetime.automation_ev2_charge_start']?.attributes.timestamp * 1000;\n  let e = hass.states['input_datetime.automation_ev2_charge_stop']?.attributes.timestamp * 1000;\n  return s && e ? [new Date(s), new Date(s), new Date(e), new Date(e)] : [];\n}",
                  "y": [
                    0,
                    1,
                    1,
                    0
                  ]
                },
                {
                  "entity": "input_datetime.automation_cheap_ev2_charge_start",
                  "name": "EV Cheap",
                  "yaxis": "y2",
                  "fill": "toself",
                  "mode": "lines",
                  "fillcolor": "rgba(0, 227, 150, 0.3)",
                  "line": {
                    "width": 0
                  },
                  "x": "$fn ({ hass }) => {\n  let s = hass.states['input_datetime.automation_cheap_ev2_charge_start']?.attributes.timestamp * 1000;\n  let e = hass.states['input_datetime.automation_cheap_ev2_charge_stop']?.attributes.timestamp * 1000;\n  return s && e ? [new Date(s), new Date(s), new Date(e), new Date(e)] : [];\n}",
                  "y": [
                    0,
                    1,
                    1,
                    0
                  ]
                },
                {
                  "entity": "input_datetime.solax_night_charge_start",
                  "name": "SolaX Night",
                  "yaxis": "y2",
                  "fill": "toself",
                  "mode": "lines",
                  "fillcolor": "rgba(119, 93, 208, 0.3)",
                  "line": {
                    "width": 0
                  },
                  "x": "$fn ({ hass }) => {\n  let s = hass.states['input_datetime.solax_night_charge_start']?.attributes.timestamp * 1000;\n  let e = hass.states['input_datetime.solax_night_charge_stop']?.attributes.timestamp * 1000;\n  return s && e ? [new Date(s), new Date(s), new Date(e), new Date(e)] : [];\n}",
                  "y": [
                    0,
                    1,
                    1,
                    0
                  ]
                },
                {
                  "entity": "input_datetime.solax_night_charge_cheap_start",
                  "name": "Solax Cheap",
                  "yaxis": "y2",
                  "fill": "toself",
                  "mode": "lines",
                  "fillcolor": "rgba(255, 69, 96, 0.25)",
                  "line": {
                    "width": 0
                  },
                  "x": "$fn ({ hass }) => {\n  let s = hass.states['input_datetime.solax_night_charge_cheap_start']?.attributes.timestamp * 1000;\n  let e = hass.states['input_datetime.solax_night_charge_cheap_stop']?.attributes.timestamp * 1000;\n  return s && e ? [new Date(s), new Date(s), new Date(e), new Date(e)] : [];\n}",
                  "y": [
                    0,
                    1,
                    1,
                    0
                  ]
                },
                {
                  "entity": "input_datetime.solax_day_charge_start",
                  "name": "SolaX Day",
                  "yaxis": "y2",
                  "fill": "toself",
                  "mode": "lines",
                  "fillcolor": "rgba(254, 176, 25, 0.3)",
                  "line": {
                    "width": 0
                  },
                  "x": "$fn ({ hass }) => {\n  let s = hass.states['input_datetime.solax_day_charge_start']?.attributes.timestamp * 1000;\n  let e = hass.states['input_datetime.solax_day_charge_stop']?.attributes.timestamp * 1000;\n  return s && e ? [new Date(s), new Date(s), new Date(e), new Date(e)] : [];\n}",
                  "y": [
                    0,
                    1,
                    1,
                    0
                  ]
                }
              ]
            }
          ]
