                    },
                    {
                      "entity": "sensor.edp_trihorario_price",
                      "name": "Price",
                      "data_generator": "if (!entity.attributes.tomorrow_hours) return []; return Object.entries(entity.attributes.tomorrow_hours)\n  .filter(([dateString, price]) => price !== null)\n  .map(([dateString, price]) => [ new Date(dateString).getTime(), price ])\n",
