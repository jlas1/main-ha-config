                "show": {
                  "extremas": true,
                  "legend_value": false
                }
              },
              "series": [
                {
                  "entity": "sensor.edp_trihorario_price",
                  "name": "Price",
                  "data_generator": "return Object.entries(entity.attributes.today_hours)\n  .filter(([dateString, price]) => price !== null)\n  .map(([dateString, price]) => [ new Date(dateString).getTime(), price ])\n"
                },
                {
                  "entity": "sensor.edp_trihorario_price",
                  "name": "Price",
                  "data_generator": "if (!entity.attributes.tomorrow_hours) return []; return Object.entries(entity.attributes.tomorrow_hours)\n  .filter(([dateString, price]) => price !== null)\n  .map(([dateString, price]) => [ new Date(dateString).getTime(), price ])\n",
                  "offset": "+1d"
                }
              ],
              "yaxis": [
                {
                  "id": "price",
                  "align_to": 10
                }
              ],
              "view_layout": {
