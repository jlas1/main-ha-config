# Home Assistant Core Secrets & Storage
secrets.yaml
.cloud/
.cache/
ip_bans.yaml

custom_components/
solcast_solar/
www/
image/
mysensors/
older/
packages/
pyscript/


# Databases & Runtime State
*.db
*.db-shm
*.db-wal
*.log
*.log.*
home-assistant.log
.ha_run.lock

# Backups & Temp files
backups/
*.tar
*.gz
tmp/

# SSL & Certificates
*.pem
*.key
*.crt

# Custom integration caches & virtual environments
__pycache__/
*.pyc
.venv/
.vscode/

# Media and TTS caches
tts/
media/
known_devices.yaml

# Ignore everything inside .storage/ by default
.storage/*

# Whitelist UI Dashboards
!.storage/lovelace
!.storage/lovelace.*
!.storage/lovelace_dashboards
!.storage/lovelace_resources

# Whitelist UI Helpers
!.storage/input_boolean
!.storage/input_button
!.storage/input_datetime
!.storage/input_number
!.storage/input_select
!.storage/input_text
!.storage/counter
!.storage/timer
!.storage/schedule
