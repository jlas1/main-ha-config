- id: '1759584837748'
  alias: Restart EV charger
  description: ''
  triggers:
  - type: turned_on
    device_id: b673bb9bf4da0c5ee75c1581175ca268
    entity_id: 7372628f0279bcfe038a1a021ffc05e5
    domain: switch
    trigger: device
    for:
      hours: 0
      minutes: 0
      seconds: 10
  conditions:
  - type: is_power
    condition: device
    device_id: cb0512f084dfe73bb627d29df25f74c4
    entity_id: de5b26b378767f29b94105407383e713
    domain: sensor
    below: 200
  actions:
  - if:
    - condition: or
      conditions:
      - condition: state
        entity_id: input_boolean.manual_override_ve_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.automatic_ve_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.grid_injection_avoidance_ve_switch
        state: 'on'
    then:
    - type: turn_off
      device_id: cb0512f084dfe73bb627d29df25f74c4
      entity_id: 773bc18359c530b24d91098ccc9f8413
      domain: switch
    - delay:
        hours: 0
        minutes: 0
        seconds: 10
        milliseconds: 0
    - type: turn_on
      device_id: cb0512f084dfe73bb627d29df25f74c4
      entity_id: 773bc18359c530b24d91098ccc9f8413
      domain: switch
    - delay:
        hours: 0
        minutes: 0
        seconds: 30
        milliseconds: 0
  mode: single
- id: '1759784699285'
  alias: Offline detection
  description: ''
  use_blueprint:
    path: Mr-Groch/offline-notification-for-sensors-with-last_seen.yaml
    input:
      hours: 6
      actions:
      - action: notify.persistent_notification
        metadata: {}
        data:
          message: '{{sensors}} Device Offline'
          title: Device Offline
      - action: notify.mobile_app_sm_a556b
        metadata: {}
        data:
          message: '{{sensors}} Device Offline'
          title: Devices offline
      exclude:
        entity_id: []
        device_id: 10ec7fd877e921d37ac37c97ed71011d
- id: '1759784908799'
  alias: Low battery warning
  description: ''
  use_blueprint:
    path: sbyx/low-battery-level-detection-notification-for-all-battery-sensors.yaml
    input:
      threshold: 25
      actions:
      - action: notify.mobile_app_sm_a556b
        metadata: {}
        data:
          message: '{{sensors}} with low battery'
          title: low battery devices
      - action: persistent_notification.create
        metadata: {}
        data:
          message: '{{sensors}} with low battery'
          title: low battery devices
      exclude:
        entity_id:
        - sensor.solax_cloud_battery
        - sensor.solax_battery_capacity
- id: '1770509525129'
  alias: Bathroom Dehudifier Automation
  description: ''
  triggers:
  - trigger: numeric_state
    entity_id:
    - sensor.suite_bathroom_average_humidity
    above: 85
    id: hum start
  - trigger: numeric_state
    entity_id:
    - sensor.suite_bathroom_average_humidity
    id: hum stop
    below: 80
  - trigger: time
    at: 08:30:01
    id: time start
    weekday:
    - mon
    - tue
    - wed
    - thu
    - fri
    enabled: false
  - trigger: time
    at: 09:30:01
    id: time start
    weekday:
    - sat
    - sun
    enabled: false
  - trigger: time
    at: '23:00:00'
    id: time stop
    enabled: false
  - type: turned_off
    device_id: c3ff174608459c5c39edfc70ab8da2c3
    entity_id: fcef13da7d40c09322c6c6796694b299
    domain: switch
    trigger: device
    id: switch off
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: numeric_state
        entity_id: sensor.suite_bathroom_average_humidity
        above: 85
      - condition: or
        conditions:
        - condition: time
          after: 08:30:00
          before: '23:00:00'
          weekday:
          - mon
          - tue
          - wed
          - thu
          - fri
          enabled: true
        - condition: time
          after: 09:30:00
          before: '23:00:00'
          weekday:
          - sat
          - sun
        enabled: false
      - condition: or
        conditions:
        - condition: trigger
          id:
          - time start
          - switch off
          - hum start
      sequence:
      - type: turn_on
        device_id: c3ff174608459c5c39edfc70ab8da2c3
        entity_id: fcef13da7d40c09322c6c6796694b299
        domain: switch
    - conditions:
      - condition: trigger
        id:
        - time stop
        - hum stop
      sequence:
      - type: turn_off
        device_id: c3ff174608459c5c39edfc70ab8da2c3
        entity_id: fcef13da7d40c09322c6c6796694b299
        domain: switch
  mode: single
- id: '1775942669525'
  alias: EV2 Auto mode
  description: ''
  triggers:
  - entity_id:
    - input_boolean.manual_override_ve2_switch
    - input_boolean.automatic_ve2_switch
    - input_boolean.grid_injection_avoidance_ve2_switch
    id: VE Switch changed state
    trigger: state
  - entity_id:
    - sensor.box_ve1_power
    below: 500
    id: VE_power_zero
    for:
      hours: 0
      minutes: 5
      seconds: 0
    trigger: numeric_state
    enabled: false
  - entity_id:
    - timer.cooldown_evcharger2
    from:
    - active
    to:
    - idle
    trigger: state
    enabled: true
  - trigger: template
    value_template: '{{ states(''sensor.ev_charger_2_status'') == ''waiting'' }}'
    id: EV charger waiting
    enabled: true
  - type: changed_states
    device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
    entity_id: 11358ce830a7565326946c9d7edf0036
    domain: switch
    trigger: device
  conditions: []
  actions:
  - if:
    - condition: state
      entity_id: input_boolean.manual_override_ve2_switch
      state: 'on'
    then:
    - alias: Set DACIA charging current to 10A if different
      if:
      - condition: not
        conditions:
        - condition: numeric_state
          entity_id: number.ev_charger_2_charging_current
          below: 10
          above: 10
      then:
      - device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
        domain: number
        entity_id: 1e436b35c66fa829aaa91ca870e35483
        type: set_value
        value: 10
  - if:
    - condition: or
      conditions:
      - condition: state
        entity_id: input_boolean.manual_override_ve2_switch
        state:
        - 'on'
      - condition: state
        entity_id: input_boolean.automatic_ve2_switch
        state:
        - 'on'
      - condition: state
        entity_id: input_boolean.grid_injection_avoidance_ve2_switch
        state:
        - 'on'
    then:
    - if:
      - condition: device
        type: is_off
        device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
        entity_id: 11358ce830a7565326946c9d7edf0036
        domain: switch
      then:
      - type: turn_on
        device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
        entity_id: 11358ce830a7565326946c9d7edf0036
        domain: switch
      else:
      - if:
        - condition: trigger
          id:
          - VE_power_zero
        then:
        - type: turn_off
          device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
          entity_id: 11358ce830a7565326946c9d7edf0036
          domain: switch
        - metadata: {}
          data:
            duration: 00:01:00
          target:
            entity_id: timer.cooldown_evcharger2
          action: timer.start
        enabled: false
      - if:
        - condition: trigger
          id:
          - EV charger waiting
        then:
        - type: turn_off
          device_id: c7e62a09c9e28972386363353820e203
          entity_id: c39e93a834577ac985242521670ec537
          domain: switch
        - delay:
            hours: 0
            minutes: 0
            seconds: 5
            milliseconds: 0
        - type: turn_on
          device_id: c7e62a09c9e28972386363353820e203
          entity_id: c39e93a834577ac985242521670ec537
          domain: switch
        enabled: false
    else:
    - type: turn_off
      device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
      entity_id: 11358ce830a7565326946c9d7edf0036
      domain: switch
  - delay:
      hours: 0
      minutes: 0
      seconds: 5
      milliseconds: 0
  mode: queued
  max: 10
- id: '1775943176391'
  alias: DACIA OMIE
  description: ''
  triggers:
  - at: input_datetime.automation_ev2_charge_start
    id: EV start charging
    trigger: time
  - at: input_datetime.automation_ev2_charge_stop
    id: EV stop charging
    enabled: true
    trigger: time
  - at: input_datetime.automation_cheap_ev2_charge_start
    id: Cheap EV start charging
    trigger: time
  - at: input_datetime.automation_cheap_ev2_charge_stop
    id: Cheap EV stop charging
    trigger: time
  conditions: []
  actions:
  - alias: Check if it's a long charging night
    if:
    - condition: and
      conditions:
      - condition: trigger
        id:
        - EV start charging
        - EV stop charging
      - alias: Checks if it's a long charging night
        condition: or
        conditions:
        - alias: Check if its monday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 0 and
            states(''input_boolean.ev2_home_office_monday'') == ''off'' else false
            }}'
        - alias: Check if its tuesday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 1 and
            states(''input_boolean.ev2_home_office_tuesday'') == ''off'' else false
            }}'
        - alias: Check if its wednesday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 2 and
            states(''input_boolean.ev2_home_office_wednesday'') == ''off'' else false
            }}'
        - alias: Check if its thursday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 3 and
            states(''input_boolean.ev2_home_office_thursday'') == ''off'' else false
            }}'
        - alias: Check if its Friday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 4 and
            states(''input_boolean.ev2_home_office_friday'') == ''off'' else false
            }}'
        - alias: Check if its Saturday
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 5 else
            false }}'
        - alias: Check if its Sunday
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 6 else
            false }}'
    then:
    - alias: Check if EV charge should start or stop
      if:
      - condition: trigger
        id:
        - EV start charging
      then:
      - alias: Set carging current to 6A if higher
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_charging_current
          above: 6
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 6
        enabled: false
      - target:
          entity_id: input_boolean.automatic_ve2_switch
        data: {}
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 1
          seconds: 0
          milliseconds: 0
      else:
      - alias: Check if EV charge should Stop
        if:
        - condition: trigger
          id:
          - EV stop charging
        then:
        - target:
            entity_id: input_boolean.automatic_ve2_switch
          data: {}
          action: input_boolean.turn_off
  - alias: Check if it's a short charging night
    if:
    - condition: and
      conditions:
      - condition: trigger
        id:
        - Cheap EV start charging
        - Cheap EV stop charging
      - alias: Checks if it's a short charging night
        condition: or
        conditions:
        - alias: Check if its monday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 0 and
            states(''input_boolean.home_office_monday'') == ''on'' else false }}'
        - alias: Check if its tuesday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 1 and
            states(''input_boolean.home_office_tuesday'') == ''on'' else false }}'
        - alias: Check if its wednesday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 2 and
            states(''input_boolean.home_office_wednesday'') == ''on'' else false }}'
        - alias: Check if its thursday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 3 and
            states(''input_boolean.home_office_thursday'') == ''on'' else false }}'
        - alias: Check if its Friday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 4 and
            states(''input_boolean.home_office_friday'') == ''on'' else false }}'
    then:
    - alias: Check if EV charge should start or stop
      if:
      - condition: trigger
        id:
        - Cheap EV start charging
      then:
      - alias: Set carging current to 6A if higher
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_charging_current
          above: 6
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 6
        enabled: false
      - target:
          entity_id: input_boolean.automatic_ve2_switch
        data: {}
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 1
          seconds: 0
          milliseconds: 0
      else:
      - alias: Check if EV charge should Stop
        if:
        - condition: trigger
          id:
          - Cheap EV stop charging
        then:
        - target:
            entity_id: input_boolean.automatic_ve2_switch
          data: {}
          action: input_boolean.turn_off
  - if:
    - condition: trigger
      id:
      - battery soc above 97
      - battery soc below 97
    - condition: numeric_state
      entity_id: sensor.solax_local_pv_output
      above: 100
    then:
    - choose:
      - conditions:
        - condition: trigger
          id:
          - battery soc above 97
        sequence:
        - metadata: {}
          data: {}
          target:
            entity_id: switch.tomada_ve
          action: switch.turn_on
      - conditions:
        - condition: trigger
          id:
          - battery soc below 97
        sequence:
        - target:
            entity_id:
            - switch.tomada_ve
          data: {}
          action: switch.turn_off
    alias: Checks if the battery is heavily charged and it's sunny
    enabled: false
  mode: queued
  max: 10
- id: '1776552505090'
  alias: Decide witch EV to charge first
  description: ''
  triggers:
  - triggers:
    - trigger: state
      entity_id:
      - sensor.ev_charger_status
      to:
      - available
      - charging
      - charged
      - waiting
      for:
        seconds: 20
      id: BMW State Changed
    - trigger: state
      entity_id:
      - sensor.ev_charger_2_status
      to:
      - available
      - charging
      - charged
      - waiting
      for:
        seconds: 20
      id: Dacia State Changed
  conditions:
  - condition: state
    entity_id: input_boolean.grid_injection_avoidance_ve_s
    state:
    - 'on'
  actions:
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ states(''sensor.ev_charger_status'') == ''available''
          }}'
        alias: BMW Charger disconnected
      - alias: DACIA Charger disconnected
        condition: template
        value_template: '{{ states(''sensor.ev_charger_2_status'') == ''available''
          }}'
      sequence:
      - metadata: {}
        data: {}
        action: input_boolean.turn_on
        enabled: false
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
      alias: Both Chargers disconnected
    - conditions:
      - condition: template
        value_template: '{{ states(''sensor.ev_charger_status'') == ''available''
          }}'
        alias: BMW Charger disconnected
      - alias: DACIA Charger connected
        condition: template
        value_template: '{{ states(''sensor.ev_charger_2_status'') == ''charged''
          }}'
      sequence:
      - metadata: {}
        data: {}
        action: input_boolean.turn_off
        enabled: true
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
      - metadata: {}
        data: {}
        action: input_boolean.turn_off
        target:
          entity_id:
          - input_boolean.grid_injection_avoidance_ve_switch
          - input_boolean.grid_injection_avoidance_ve2_switch
      - delay:
          hours: 0
          minutes: 0
          seconds: 10
          milliseconds: 0
      - alias: Set DACIA charging current to 10A if different
        if:
        - condition: not
          conditions:
          - condition: numeric_state
            entity_id: number.ev_charger_2_charging_current
            below: 10
            above: 10
        then:
        - device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
          domain: number
          entity_id: 1e436b35c66fa829aaa91ca870e35483
          type: set_value
          value: 10
      - delay:
          hours: 0
          minutes: 0
          seconds: 2
          milliseconds: 0
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve2_switch
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 0
          seconds: 10
          milliseconds: 0
      alias: DACIA Charger connected and BMW disconnected
    - conditions:
      - alias: BMW Charger connected
        condition: template
        value_template: '{{ states(''sensor.ev_charger_status'') == ''charged'' }}'
      - alias: DACIA Charger disconnected
        condition: template
        value_template: '{{ states(''sensor.ev_charger_2_status'') == ''available''
          }}'
      sequence:
      - metadata: {}
        data: {}
        action: input_boolean.turn_off
        enabled: true
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
      - metadata: {}
        data: {}
        action: input_boolean.turn_off
        target:
          entity_id:
          - input_boolean.grid_injection_avoidance_ve_switch
          - input_boolean.grid_injection_avoidance_ve2_switch
      - delay:
          hours: 0
          minutes: 0
          seconds: 10
          milliseconds: 0
      - alias: Set BMW charging current to 10A if different
        if:
        - condition: not
          conditions:
          - condition: numeric_state
            entity_id: number.ev_charger_charging_current
            above: 10
            below: 10
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 10
        enabled: true
      - delay:
          hours: 0
          minutes: 0
          seconds: 2
          milliseconds: 0
      - metadata: {}
        data: {}
        action: input_boolean.turn_on
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve_switch
      - delay:
          hours: 0
          minutes: 0
          seconds: 10
          milliseconds: 0
      alias: BMW Charger connected and DACIA disconnected
    - conditions:
      - condition: or
        conditions:
        - alias: BMW Charger charging
          condition: template
          value_template: '{{ states(''sensor.ev_charger_status'') == ''charging''
            }}'
        - alias: DACIA Charger connected
          condition: template
          value_template: '{{ states(''sensor.ev_charger_2_status'') == ''charged''
            }}'
        enabled: true
      - condition: or
        conditions:
        - alias: DACIA Charger charging
          condition: template
          value_template: '{{ states(''sensor.ev_charger_2_status'') == ''charging''
            }}'
        - alias: BMW Charger connected
          condition: template
          value_template: '{{ states(''sensor.ev_charger_status'') == ''charged''
            }}'
        enabled: true
      sequence:
      - metadata: {}
        data: {}
        action: input_boolean.turn_off
        enabled: true
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
      - metadata: {}
        data: {}
        target:
          entity_id:
          - input_boolean.grid_injection_avoidance_ve2_switch
          - input_boolean.grid_injection_avoidance_ve_switch
        action: input_boolean.turn_off
        enabled: true
      - delay:
          hours: 0
          minutes: 0
          seconds: 30
          milliseconds: 0
      - alias: Set BMW charging current to 6A if higher
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_charging_current
          above: 6
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 6
        enabled: true
      - alias: Set DACIA charging current to 6 if higher
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_2_charging_current
          above: 6
        then:
        - device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
          domain: number
          entity_id: 1e436b35c66fa829aaa91ca870e35483
          type: set_value
          value: 6
      - delay:
          hours: 0
          minutes: 0
          seconds: 2
          milliseconds: 0
      - metadata: {}
        data: {}
        target:
          entity_id:
          - input_boolean.grid_injection_avoidance_ve2_switch
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 0
          seconds: 2
          milliseconds: 0
      - metadata: {}
        data: {}
        target:
          entity_id:
          - input_boolean.grid_injection_avoidance_ve_switch
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 1
          seconds: 0
          milliseconds: 0
      alias: BMW Charger charging and DACIA connected or vice-versa
  mode: single
- id: '1776717102429'
  alias: backup
  description: ''
  triggers: []
  conditions: []
  actions:
  - alias: Set BMW charging current to 10A if lower
    if:
    - condition: numeric_state
      entity_id: number.ev_charger_charging_current
      below: 10
    then:
    - device_id: b673bb9bf4da0c5ee75c1581175ca268
      domain: number
      entity_id: e8d2960d523eed419247a39daf9c38fb
      type: set_value
      value: 10
  - delay:
      hours: 0
      minutes: 0
      seconds: 1
      milliseconds: 0
  - metadata: {}
    data: {}
    target:
      entity_id: input_boolean.grid_injection_avoidance_ve_switch
    action: input_boolean.turn_on
  - delay:
      hours: 0
      minutes: 0
      seconds: 30
      milliseconds: 0
  - if:
    - type: is_power
      condition: device
      device_id: b673bb9bf4da0c5ee75c1581175ca268
      entity_id: a6cf4037c751e14364bc081080802862
      domain: sensor
      below: 0.03
    then:
    - metadata: {}
      data: {}
      target:
        entity_id: input_boolean.grid_injection_avoidance_ve_switch
      action: input_boolean.turn_off
      enabled: false
    - delay:
        hours: 0
        minutes: 0
        seconds: 1
        milliseconds: 0
      enabled: false
    - alias: Set BMW charging current to 6A if higher
      if:
      - condition: numeric_state
        entity_id: number.ev_charger_charging_current
        above: 6
      then:
      - device_id: b673bb9bf4da0c5ee75c1581175ca268
        domain: number
        entity_id: e8d2960d523eed419247a39daf9c38fb
        type: set_value
        value: 6
      enabled: false
    - alias: Set DACIA charging current to 10A if different
      if:
      - condition: numeric_state
        entity_id: number.ev_charger_2_charging_current
        below: 9
        above: 11
      then:
      - device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
        domain: number
        entity_id: 1e436b35c66fa829aaa91ca870e35483
        type: set_value
        value: 10
    - delay:
        hours: 0
        minutes: 0
        seconds: 1
        milliseconds: 0
    - metadata: {}
      data: {}
      target:
        entity_id: input_boolean.grid_injection_avoidance_ve2_switch
      action: input_boolean.turn_on
    - delay:
        hours: 0
        minutes: 1
        seconds: 0
        milliseconds: 0
    - if:
      - type: is_power
        condition: device
        device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
        entity_id: 211f0a91e720f703c7a35a774750d8ed
        domain: sensor
        below: 0.03
      then:
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve2_switch
        action: input_boolean.turn_off
        enabled: false
      - delay:
          hours: 0
          minutes: 0
          seconds: 1
          milliseconds: 0
        enabled: false
      - alias: Set charging current to 10A if different
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_2_charging_current
          below: 9
          above: 11
        then:
        - device_id: 65d4c6f29956f2d96c402ee9ed6c4b8f
          domain: number
          entity_id: 1e436b35c66fa829aaa91ca870e35483
          type: set_value
          value: 10
        enabled: false
      - action: input_boolean.turn_on
        metadata: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
        data: {}
  mode: single
- id: '1776724759904'
  alias: backup 2
  description: ''
  triggers:
  - at: '19:00:00'
    id: Prepare for night energy usage
    trigger: time
    enabled: false
  conditions: []
  actions:
  - target:
      entity_id: input_text.automation_low_cost_coopernico
    data:
      value: "{% set ns = namespace(attr_dict=[]) %} {%- set price_map = (state_attr('sensor.template_coopernico_spot_price_bihorario','today_hours').values()|list)[22:24]
        %} {%- set price_map = price_map + (state_attr('sensor.template_coopernico_spot_price_bihorario','tomorrow_hours').values()|list)[0:8]
        %} {%- set min_price = price_map|min %} {%- set dh = namespace(time=[]) %}\n\n{%-
        for t in range (9,-1,-1) %}\n  {%- set value = price_map[t] %}\n  {%- set
        dh.time = dh.time + [(t,value)] %}\n{%- endfor %} {%- set mapper = dict(dh.time)
        %} {%- set key = mapper.keys()|list %} {%- set val = mapper.values()|list
        %} {%- set val_min = mapper.values()|min %} {% set ts_1h = as_timestamp(now().replace(hour=21,minute=0,second=0)+timedelta(hours=key[val.index(val_min)]))
        %}\n{%- set dh = namespace(time=[]) %} {%- for t in range (8,-1,-1) %}\n  {%-
        set value = (price_map[t]+price_map[t+1])/2 %}\n  {%- if value < min_price
        + 7.5 %}\n    {%- set value = min_price %}\n  {%- endif %}\n  {%- set dh.time
        = dh.time + [(t,value)] %}\n{%- endfor %} {%- set mapper = dict(dh.time) %}
        {%- set key = mapper.keys()|list %} {%- set val = mapper.values()|list %}
        {%- set val_min = mapper.values()|min %} {% set ts_2h = as_timestamp(now().replace(hour=21,minute=0,second=0)+timedelta(hours=key[val.index(val_min)]))
        %}\n\n{%- set dh = namespace(time=[]) %} {%- for t in range (7,-1,-1) %}\n
        \ {%- set value = (price_map[t]+price_map[t+1]+price_map[t+2])/3 %}\n  {%-
        if value < min_price + 7.5 %}\n    {%- set value = min_price %}\n  {%- endif
        %}\n  {%- set dh.time = dh.time + [(t,value)] %}\n{%- endfor %} {%- set mapper
        = dict(dh.time) %} {%- set key = mapper.keys()|list %} {%- set val = mapper.values()|list
        %} {%- set val_min = mapper.values()|min %} {% set ts_3h = as_timestamp(now().replace(hour=21,minute=0,second=0)+timedelta(hours=key[val.index(val_min)]))
        %}\n{%- set dh = namespace(time=[]) %} {%- for t in range (5,-1,-1) %}\n  {%-
        set value = (price_map[t]+price_map[t+1]+price_map[t+2]+price_map[t+3]+price_map[t+4])/5
        %}\n  {%- set dh.time = dh.time + [(t,value)] %}\n{%- endfor %} {%- set mapper
        = dict(dh.time) %} {%- set key = mapper.keys()|list %} {%- set val = mapper.values()|list
        %} {%- set val_min = mapper.values()|min %} {% set ts_5h = as_timestamp(now().replace(hour=21,minute=0,second=0)+timedelta(hours=key[val.index(val_min)]))
        %}\n{%- set ns = namespace()  %} {%- set ns.min = 99  %} {%- set ns.max =
        0  %}\n{%- for t in range (9,-1,-1) %}\n  {%- if price_map[t] <= min_price
        * 1.1 %}\n    {%- set ns.min = t if ns.min > t %}\n    {%- if (ns.max < t)
        %}\n      {% set ns.max = t %}\n    {% endif %}\n  {%- endif %}\n{%- endfor
        %}\n{% set ts_start = as_timestamp(now().replace(hour=21,minute=0,second=0)+timedelta(hours=ns.min))
        %} {% set ts_stop = as_timestamp(now().replace(hour=21,minute=0,second=0)+timedelta(hours=ns.max))
        %}\n{{ ts_2h|int|string + '|' + ts_3h|int|string + '|' + ts_5h|int|string
        + '|' + ts_1h|int|string + \"|\" + ts_start|int|string + \"|\" + ts_stop|int|string
        + \"|\" + min_price|string }}\n"
    action: input_text.set_value
  - target:
      entity_id: input_text.automation_afternoon_low_cost_coopernico
    data:
      value: "{% set ns = namespace(attr_dict=[]) %} {%- set price_map = (state_attr('sensor.template_coopernico_spot_price_bihorario','tomorrow_hours').values()|list)[8:20]
        %} {%- set min_price = price_map|min %}\n{%- set dh = namespace(time=[]) %}
        {%- for t in range (10,-1,-1) %}\n  {%- set value = (price_map[t]+price_map[t+1])/2
        %}\n  {%- if value < min_price + 7.5 %}\n    {%- set value = min_price %}\n
        \ {%- endif %}\n  {%- set dh.time = dh.time + [(t,value)] %}\n{%- endfor %}
        {%- set mapper = dict(dh.time) %}\n{%- set key = mapper.keys()|list %}\n{%-
        set val = mapper.values()|list %}\n{%- set val_min = mapper.values()|min %}\n{%
        set ts_2h = as_timestamp(now().replace(hour=7,minute=0,second=0)+timedelta(hours=key[val.index(val_min)])+timedelta(days=1))
        %} {{ ts_2h|int|string + \"|\" + min_price|string }}\n"
    action: input_text.set_value
  - target:
      entity_id: input_text.automation_low_cost_coopernico
    data:
      value: "{%- set price_map = (state_attr('sensor.template_coopernico_spot_price_bihorario','today_hours').values()|list)[22:24]
        %} {%- set price_map = price_map + (state_attr('sensor.template_coopernico_spot_price_bihorario','tomorrow_hours').values()|list)[0:8]
        %} {%- set min_price = price_map|min %} {%- set ns = namespace()  %} {%- set
        ns.min = 99  %} {%- set ns.max = 0  %}\n{%- for t in range (9,-1,-1) %}\n
        \ {%- if price_map[t] <= min_price * 1.1 %}\n    {%- set ns.min = t if ns.min
        > t %}\n    {%- if (ns.max < t) %}\n      {% set ns.max = t %}\n    {% endif
        %}\n  {%- endif %}\n{%- endfor %}\n{%- set ns.max = ns.max + 1  %} {% set
        ts_start = as_timestamp(now().replace(hour=22,minute=0,second=0)+timedelta(hours=ns.min))
        %} {% set ts_stop = as_timestamp(now().replace(hour=22,minute=0,second=0)+timedelta(hours=ns.max))
        %} {%- set current = states('input_text.automation_low_cost_coopernico') %}
        {{ current + \"|\" + ts_start|int|string + \"|\" + ts_stop|int|string}}\n"
    action: input_text.set_value
    enabled: false
  - target:
      entity_id:
      - input_datetime.night_water_heating_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[0]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.night_water_heating_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[0]
        | int + 3600*2 }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.late_afternoon_water_heating_start
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.late_afternoon_water_heating_stop
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int + 3600*2}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_ev_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_ev2_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_ev_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int + 3600*5}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_ev2_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int + 3600*5}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_cheap_ev_charge_start
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int }}        \n"
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_cheap_ev2_charge_start
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int }}        \n"
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_cheap_ev_charge_stop
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int + 3600*1}}            \n"
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_cheap_ev2_charge_stop
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int + 3600*1}}            \n"
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[1]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[1]
        | int + 3600*3}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_day_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_day_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int + 3600*2}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_cheap_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[4]
        }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_cheap_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[5]
        }}

        '
    action: input_datetime.set_datetime
  mode: single
- id: '1776725901783'
  alias: backup 3
  description: ''
  triggers:
  - entity_id:
    - input_number.new_battery_target
    - input_number.new_day_battery_target
    id: new bat target
    trigger: state
    enabled: true
  - at: input_datetime.solax_night_charge_start
    trigger: time
    enabled: true
  - at: input_datetime.solax_night_charge_stop
    trigger: time
  - at: input_datetime.solax_night_charge_cheap_stop
    trigger: time
  - at: '21:30:00'
    id: Time to update battery charge
    trigger: time
  - at: input_datetime.solax_cheap_night_start
    id: set night soc
    trigger: time
  - at: input_datetime.solax_day_charge_start
    id: set day soc
    trigger: time
  - at: input_datetime.solax_day_charge_stop
    trigger: time
  - entity_id:
    - sensor.solax_local_battery_soc
    below: input_number.new_battery_target
    enabled: true
    trigger: numeric_state
  - entity_id:
    - sensor.solax_local_battery_soc
    below: input_number.new_day_battery_target
    enabled: true
    trigger: numeric_state
  - entity_id:
    - sensor.solax_local_battery_soc
    enabled: false
    trigger: state
  - entity_id:
    - sensor.solax_local_battery_soc
    enabled: true
    trigger: numeric_state
    for:
      hours: 0
      minutes: 0
      seconds: 10
    above: 94
    id: Battery full
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Time to update battery charge
        enabled: true
      sequence:
      - data_template:
          entity_id: input_text.solar_calculations
          value: "{%- set average_energy = 0.65 %} {%- set forecast_today = state_attr('sensor.solcast_pv_forecast_forecast_tomorrow',
            'detailedHourly') %}\n{## Find what is the cheapest rate, the night or
            day charge slot ##}\n{%- set night_price = states('input_text.automation_low_cost_coopernico').split('|')[6]|int
            %} {%- set afternoon_price = states('input_text.automation_afternoon_low_cost_coopernico').split('|')[1]|int
            %} {%- if as_timestamp(states('input_datetime.solax_night_charge_stop'))
            > as_timestamp(states('input_datetime.solax_night_charge_cheap_stop'))
            %}\n   {%- set night_stop = as_timestamp(states('input_datetime.solax_night_charge_stop'))
            %}\n{%- else %}\n   {%- set night_stop = as_timestamp(states('input_datetime.solax_night_charge_cheap_stop'))
            %}    \n{%- endif %}\n\n{%- if afternoon_price < night_price %}\n  {##
            Afternoon price is better, charge battery full in the afternoon and barely
            during the night ##}\n  {%- set ts_full_start = as_timestamp(states('input_datetime.solax_day_charge_stop'))
            %}\n  {%- set ts_bare_start = night_stop %}\n  {%- set full_water_battery
            = 1 %}\n  {%- set bare_water_battery = 0 %}\n  {%- set full_water_battery
            = 2 %}\n  {%- set bare_water_battery = 1 %}\n{%- else %}\n  {## Night
            price is better, charge battery full in the Night and barely during the
            afternoon ##}\n  {%- set ts_full_start = night_stop %}\n  {%- set ts_bare_start
            = as_timestamp(states('input_datetime.solax_day_charge_stop')) %}\n  {%-
            set full_water_battery = 1 %}\n  {%- set bare_water_battery = 0 %}\n  {%-
            set full_water_battery = 3 %}\n  {%- set bare_water_battery = 2 %}\n{%-
            endif %}\n{## Find the value to charge the battery the most ##}\n{%- set
            TargetbatteryKW = 0 %} {%- set var = namespace(total=0,batteryKW = 0,MaxbatteryKW=0,MinbatteryKW=0)
            %} {%- for record in forecast_today %}\n  {%- set ts = as_timestamp(record.period_start)
            %}      \n  {%- if ts >= ts_full_start %}\n    {%- set var.batteryKW =
            var.batteryKW + record.pv_estimate - average_energy %}\n    {%- set var.total
            = var.total + record.pv_estimate %}\n    {%- if var.batteryKW > var.MaxbatteryKW
            %}\n       {%- set var.MaxbatteryKW = var.batteryKW %}\n    {%- endif
            %}\n    {%- if var.batteryKW < var.MinbatteryKW %}\n      {%- set var.MinbatteryKW
            = var.batteryKW %}\n    {%- endif %}\n  {%- endif %}\n{%- endfor %}\n
            \    \n{%- if (var.MaxbatteryKW - var.MinbatteryKW) < (10 + full_water_battery)
            %}\n  {%- set TargetbatteryKW = (10 + full_water_battery) - (var.MaxbatteryKW)
            %}\n  {%- if (TargetbatteryKW > 10) %}\n    {%- set TargetbatteryKW =
            10 %}\n  {%- endif %}\n{%- else %}\n  {%- if var.MinbatteryKW < 0 %}\n
            \   {%- set TargetbatteryKW = 0 - var.MinbatteryKW %}\n  {%- endif %}\n
            \ {%- if var.MinbatteryKW < -10 %}\n      {%- set TargetbatteryKW = 10
            %}\n  {%- endif %}\n{%- endif %}\n{%- set FullTargetbatterypercent = ('%2.0f'
            %(TargetbatteryKW * 8.9 + 11)) | int %}\n{## Find the value to barely
            charge the battery ##}\n{%- set TargetbatteryKW = 0 %} {%- set var = namespace(total=0,batteryKW
            = -bare_water_battery,MaxbatteryKW=0,MinbatteryKW=0) %} {%- for record
            in forecast_today %}\n  {%- set ts = as_timestamp(record.period_start)
            %}      \n  {%- if ts >= ts_bare_start %}\n    {%- if (ts_bare_start <
            ts_full_start and ts <= ts_full_start) or ts_bare_start > ts_full_start
            %}\n      {%- set var.batteryKW = var.batteryKW + record.pv_estimate -
            average_energy %}\n      {%- set var.total = var.total + record.pv_estimate
            %}\n      {%- if var.batteryKW > var.MaxbatteryKW %}\n         {%- set
            var.MaxbatteryKW = var.batteryKW %}\n      {%- endif %}\n    {%- endif
            %}\n    {%- if var.batteryKW < var.MinbatteryKW %}\n      {%- set var.MinbatteryKW
            = var.batteryKW %}\n    {%- endif %}\n  {%- endif %}\n{%- endfor %}\n
            \    \n  {%- set TargetbatteryKW = - (var.MinbatteryKW) %}\n  {%- if (TargetbatteryKW
            > 9) %}\n    {%- set TargetbatteryKW = 9 %}\n  {%- elif TargetbatteryKW
            < 0 %}\n    {%- set TargetbatteryKW = 0 %}\n  {%- endif %}\n\n{%- set
            BareTargetbatterypercent = ('%2.0f' %(TargetbatteryKW * 8.9 + 11)) | int
            %}\n{%- if afternoon_price < night_price %}\n  {## Afternoon price is
            better, charge battery full in the afternoon and barely during the night
            ##}\n  {%- set batt_night = BareTargetbatterypercent %}\n  {%- set batt_afternoon
            = FullTargetbatterypercent %}\n{%- else %}\n  {## Night price is better,
            charge battery full in the Night and barely during the afternoon ##}\n
            \ {%- set batt_afternoon = BareTargetbatterypercent %}\n  {%- set batt_night
            = FullTargetbatterypercent %}\n{%- endif %}\n{%- if batt_afternoon > 90
            %}\n  {%- set batt_afternoon = 90 %}\n{%- endif %}\n{{ '%2.0f' %(batt_night)
            ~'|'~ '%2.0f' %(batt_afternoon) ~'|'~ '%2.3f' %(var.MaxbatteryKW) ~'|'~
            '%2.3f' %(var.MinbatteryKW) ~'|'~ '%2.3f' %(TargetbatteryKW) ~'|'~ '%2.3f'
            %(var.MaxbatteryKW - var.MinbatteryKW -10)  }} \n"
        enabled: true
        action: input_text.set_value
      - target:
          entity_id:
          - input_number.new_battery_target
        data:
          value: '{{ states(''input_text.solar_calculations'').split(''|'')[0] | int
            }}

            '
        enabled: true
        action: input_number.set_value
      - target:
          entity_id:
          - input_number.new_day_battery_target
        data:
          value: '{{ states(''input_text.solar_calculations'').split(''|'')[1] | int
            }}

            '
        enabled: true
        action: input_number.set_value
    - conditions:
      - condition: trigger
        id: ''
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to battery target
        if:
        - alias: Test if min SOC is equal to target SOC
          condition: template
          value_template: '{{ states(''sensor.solax_local_battery_min_soc'') | int
            != states(''input_number.new_battery_target'') | int }}'
        then:
        - alias: 'Set minimum soc charge '
          repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_battery_target'') }}'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_min_soc'')
                  | int == states(''input_number.new_battery_target'' ) | int }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
      alias: Stop discharge at night
    - conditions:
      - condition: trigger
        id: ''
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to battery target
        if:
        - alias: Test if min SOC is equal to target SOC
          condition: template
          value_template: '{{ states(''sensor.solax_local_battery_min_soc'') | int
            != states(''input_number.new_day_battery_target'')|int }}'
        then:
        - alias: 'Set minimum soc charge '
          repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_day_battery_target'')|int }}'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_min_soc'')
                  | int == states(''input_number.new_day_battery_target'')|int  }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
      alias: Stop discharge at day
  - choose:
    - conditions:
      - condition: time
        after: input_datetime.solax_night_charge_start
        before: input_datetime.solax_night_charge_stop
        alias: It's night charging time
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: input_number.new_battery_target
      sequence:
      - alias: Checks and sets battery charge target
        if:
        - condition: template
          value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
            int (60) !=  states(''input_number.new_battery_target'')| int (60) }}'
          alias: Check if battery target is uptodate
        then:
        - repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_battery_target'') | int (60)
                  }}'
              action: rest_command.solax_local_set_charge_battery_from_grid
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
                  int (60)  ==  states(''input_number.new_battery_target'')| int (60)
                  }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set new charging battery target
      - alias: Checks and sets battery charge start
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: '22:00'
        then:
        - alias: Set Charging start time
          repeat:
            sequence:
            - data:
                value: '{{ 22 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: '22:00'
      alias: Start Battery night charging
    - conditions:
      - condition: and
        conditions:
        - condition: template
          value_template: '{{ now() > states(''input_datetime.solax_night_charge_cheap_stop'')
            | as_datetime | as_local }}'
          alias: It's after cheap charging time
          enabled: true
        - condition: template
          value_template: '{{ now() > states(''input_datetime.solax_night_charge_stop'')
            | as_datetime | as_local }}'
          alias: It's after normal charging time
        - alias: It's before day charging time
          condition: template
          value_template: '{{ now() < states(''input_datetime.solax_day_charge_start'')
            | as_datetime | as_local }}'
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_min_soc
          above: 11
        then:
        - repeat:
            sequence:
            - data:
                level: '11'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: numeric_state
                entity_id: sensor.solax_local_battery_min_soc
                below: 12
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set minimum charge to 11
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: 08:00
        then:
        - alias: disable charging
          repeat:
            sequence:
            - data:
                value: '{{ 8 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: 08:00
      alias: Stop Battery night charging
    - conditions:
      - condition: time
        after: input_datetime.solax_day_charge_start
        before: input_datetime.solax_day_charge_stop
        alias: It's day charging time
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: input_number.new_day_battery_target
      sequence:
      - alias: Checks and sets battery charge target
        if:
        - condition: template
          value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
            int (60) !=  states(''input_number.new_day_battery_target'')| int (60)
            }}'
          alias: Check if battery target is uptodate
        then:
        - repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_day_battery_target'') | int (60)
                  }}'
              action: rest_command.solax_local_set_charge_battery_from_grid
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
                  int (60)  ==  states(''input_number.new_day_battery_target'')| int
                  (60) }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set new charging battery target
      - alias: Checks and sets battery charge start
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: '10:00'
        then:
        - alias: Set Charging start time
          repeat:
            sequence:
            - data:
                value: '{{ 10 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: '22:00'
      alias: Start Battery day charging
    - conditions:
      - condition: template
        value_template: '{{ now() > states(''input_datetime.solax_day_charge_stop'')
          | as_datetime | as_local }}'
        alias: It's after day charging time
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_min_soc
          above: 11
        then:
        - repeat:
            sequence:
            - data:
                level: '11'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: numeric_state
                entity_id: sensor.solax_local_battery_min_soc
                below: 12
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set minimum charge to 11
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: 08:00
        then:
        - alias: disable charging
          repeat:
            sequence:
            - data:
                value: '{{ 8 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: 08:00
      alias: Stop Battery day charging
    - conditions:
      - condition: time
        after: input_datetime.solax_day_charge_start
        before: input_datetime.solax_day_charge_stop
        alias: It's day charging time
      - condition: trigger
        id:
        - Battery full
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_min_soc
          above: 11
        then:
        - repeat:
            sequence:
            - data:
                level: '11'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: numeric_state
                entity_id: sensor.solax_local_battery_min_soc
                below: 12
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set minimum charge to 11
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: 08:00
        then:
        - alias: disable charging
          repeat:
            sequence:
            - data:
                value: '{{ 8 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: 08:00
      alias: Stop Battery day charging if battery full
  mode: queued
  max: 10
- id: '1776737700339'
  alias: DACIA- Limit Power to 25A
  description: ''
  triggers:
  - entity_id: sensor.house_import_power
    above: 5500
    trigger: numeric_state
  conditions:
  - condition: state
    entity_id: sensor.ev_charger_2_status
    state: charging
  actions:
  - if:
    - condition: state
      entity_id: input_boolean.ve2_is_throttled
      state: 'off'
    then:
    - action: input_number.set_value
      target:
        entity_id: input_number.ve2_saved_current
      data:
        value: '{{ states(''number.ev_charger_2_charging_current'') | float }}'
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.ve2_is_throttled
  - variables:
      auto_was_on: '{{ is_state(''input_boolean.automatic_ve2_switch'', ''on'') }}'
      manual_was_on: '{{ is_state(''input_boolean.manual_override_ve2_switch'', ''on'')
        }}'
      new_current: '{% set import_w = states(''sensor.house_import_power'') | float(5500)
        %} {% set current_a = states(''number.ev_charger_2_charging_current'') | float(16)
        %} {% set excess_a = (import_w - 5500) / 220 %} {% set target_a = current_a
        - excess_a %} {% if target_a >= 13 %} 13 {% elif target_a >= 10 %} 10 {% elif
        target_a >= 8 %} 8 {% else %} 6 {% endif %}

        '
  - action: input_boolean.turn_off
    target:
      entity_id:
      - input_boolean.automatic_ve2_switch
      - input_boolean.manual_override_ve2_switch
  - action: number.set_value
    target:
      entity_id: number.ev_charger_2_charging_current
    data:
      value: '{{ new_current }}'
  - delay:
      seconds: 2
  - if:
    - condition: template
      value_template: '{{ auto_was_on }}'
    then:
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.automatic_ve2_switch
  - if:
    - condition: template
      value_template: '{{ manual_was_on }}'
    then:
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.manual_override_ve2_switch
  mode: single
- id: '1776738345940'
  alias: DACIA - Restore to 25A
  description: ''
  triggers:
  - value_template: '{# Fetch live data #} {% set import_w = states(''sensor.house_import_power'')
      | float(5500) %} {% set saved_a = states(''input_number.ve2_saved_current'')
      | float(16) %} {% set current_a = states(''number.ev_charger_2_charging_current'')
      | float(6) %}

      {# Calculate what the wattage WOULD be if we restored the saved current #} {%
      set projected_w = import_w + ((saved_a - current_a) * 220) %}

      {# Trigger only if it''s safe (under 5300W buffer) AND the throttle flag is
      active #} {{ projected_w < 5300 and is_state(''input_boolean.ve2_is_throttled'',
      ''on'') }}

      '
    trigger: template
  conditions:
  - condition: or
    conditions:
    - condition: state
      entity_id: input_boolean.automatic_ve2_switch
      state: 'on'
    - condition: state
      entity_id: input_boolean.manual_override_ve2_switch
      state: 'on'
  actions:
  - variables:
      auto_was_on: '{{ is_state(''input_boolean.automatic_ve2_switch'', ''on'') }}'
      manual_was_on: '{{ is_state(''input_boolean.manual_override_ve2_switch'', ''on'')
        }}'
      saved_current: '{{ states(''input_number.ve2_saved_current'') | int(16) }}'
  - action: input_boolean.turn_off
    target:
      entity_id:
      - input_boolean.automatic_ve2_switch
      - input_boolean.manual_override_ve2_switch
  - action: number.set_value
    target:
      entity_id: number.ev_charger_2_charging_current
    data:
      value: '{{ saved_current }}'
  - delay:
      seconds: 2
  - if:
    - condition: template
      value_template: '{{ auto_was_on }}'
    then:
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.automatic_ve2_switch
  - if:
    - condition: template
      value_template: '{{ manual_was_on }}'
    then:
    - action: input_boolean.turn_on
      target:
        entity_id: input_boolean.manual_override_ve2_switch
  - action: input_boolean.turn_off
    target:
      entity_id: input_boolean.ve2_is_throttled
  mode: single
- id: '1776803914159'
  alias: SolaX - Scheduled EV Discharge Limiter
  description: ''
  triggers:
  - alias: Trigger when EV Start schedule is reached
    at:
    - input_datetime.automation_ev_charge_start
    - input_datetime.automation_ev2_charge_start
    id: limit_battery
    trigger: time
  - alias: Trigger when EV Stop schedule is reached
    at:
    - input_datetime.automation_ev_charge_stop
    - input_datetime.automation_ev2_charge_stop
    id: restore_battery
    trigger: time
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id: limit_battery
      sequence:
      - alias: Check if battery is not already at 12A
        condition: template
        value_template: '{{ states(''number.solax_battery_discharge_max_current'')
          | float(0) != 12 }}'
      - alias: Limit SolaX battery discharge to 12A
        action: number.set_value
        target:
          entity_id: number.solax_battery_discharge_max_current
        data:
          value: '12'
    - conditions:
      - condition: trigger
        id: restore_battery
      sequence:
      - condition: template
        alias: Check if battery is not already at 25A
        value_template: '{{ states(''number.solax_battery_discharge_max_current'')
          | float(0) != 25 }}'
      - action: number.set_value
        alias: Restore SolaX battery discharge to 25A
        target:
          entity_id: number.solax_battery_discharge_max_current
        data:
          value: 25
  mode: queued
- id: '1776806970396'
  alias: SOLAX Automations Modbus
  description: ''
  triggers:
  - entity_id:
    - input_number.new_battery_target
    - input_number.new_day_battery_target
    id: new bat target
    trigger: state
  - at: input_datetime.solax_night_charge_start
    trigger: time
  - at: input_datetime.solax_night_charge_stop
    trigger: time
  - at: input_datetime.solax_night_charge_cheap_stop
    trigger: time
  - at: '21:30:00'
    id: Time to update battery charge
    trigger: time
  - trigger: template
    value_template: '{{ now().strftime(''%H:%M'') == (states(''input_datetime.solax_day_charge_start'')
      | as_datetime - timedelta(minutes=10)).strftime(''%H:%M'') }}'
    id: Time to update battery charge
  - at: input_datetime.solax_cheap_night_start
    id: set night soc
    trigger: time
  - at: input_datetime.solax_day_charge_start
    id: set day soc
    trigger: time
  - at: input_datetime.solax_day_charge_stop
    trigger: time
  - entity_id:
    - sensor.solax_local_battery_soc
    below: input_number.new_battery_target
    enabled: true
    trigger: numeric_state
  - entity_id:
    - sensor.solax_local_battery_soc
    below: input_number.new_day_battery_target
    enabled: true
    trigger: numeric_state
  - entity_id:
    - sensor.solax_local_battery_soc
    enabled: false
    trigger: state
  - entity_id:
    - sensor.solax_local_battery_soc
    enabled: true
    trigger: numeric_state
    for:
      hours: 0
      minutes: 0
      seconds: 10
    above: 94
    id: Battery full
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Time to update battery charge
        enabled: true
      sequence:
      - data_template:
          entity_id: input_text.solar_calculations
          value: "{# --- 1. CORE CONFIGURATION & TIME CONTEXT --- #}  {%- set average_energy
            = 0.75 %} {# Fixed consumption in kW (750W) synced #} {%- set min_soc
            = 11 %}  {%- set max_soc = 90 %} {# Absolute cap to ensure battery never
            hits 100% #} {%- set pct_per_kw = 8.9 %} {# Conversion factor for your
            battery size #}\n{# Calculate total usable kWh within the safe SOC limits
            #} {%- set usable_max_kw = (max_soc - min_soc) / pct_per_kw %}\n{# Determine
            if we are calculating for Tomorrow (21:30 run) or Today (Mid-day correction)
            #} {%- set is_night_run = now().hour >= 20 %} {%- set forecast_data =
            state_attr('sensor.solcast_pv_forecast_forecast_tomorrow', 'detailedHourly')
            if is_night_run else state_attr('sensor.solcast_pv_forecast_forecast_today',
            'detailedHourly') %} {%- set forecast_data = forecast_data or [] %}\n{#
            --- 2. THE REALITY CHECK (Only applies during the mid-day run) --- #}
            {%- set w_p50 = 0.8 %} {%- if not is_night_run %}\n  {%- set actual_pv_today
            = states('sensor.solax_local_pv_output') | float(0) %}\n  {%- set expected_pv_today
            = states('sensor.solcast_pv_forecast_forecast_today') | float(0) %}\n
            \ {%- set remaining_p50 = states('sensor.solcast_pv_forecast_forecast_remaining_today')
            | float(0) %}\n  {%- set expected_pv_so_far = expected_pv_today - remaining_p50
            %}\n\n  {%- if expected_pv_so_far > 1.0 %}\n    {%- set ratio = actual_pv_today
            / expected_pv_so_far %}\n    {%- set w_p50 = [[(ratio - 0.5) * 2.0, 0.8]
            | min, 0.0] | max %}\n  {%- endif %}\n{%- endif %} {%- set w_p10 = 1.0
            - w_p50 %}\n{# --- 3. SEASONALITY, OFFSETS & PRICING --- #}   {%- set
            is_winter = now().month >= 10 or now().month <= 4 %}  {%- set f_offset
            = 1.0 if is_winter else 0.5 %} {# Safety buffer (kW) when maximizing charge
            #} {%- set b_offset = 1.5 if is_winter else 0.5 %} {# Safety buffer (kW)
            when minimizing charge #}\n{%- set night_tariff_str = states('input_text.automation_low_cost_coopernico')
            %}  {%- set night_price = night_tariff_str.split('|')[6] | default(999)
            | int(999) if night_tariff_str else 999 %} \n{%- set afternoon_tariff_str
            = states('input_text.automation_afternoon_low_cost_coopernico') %} {%-
            set afternoon_price = afternoon_tariff_str.split('|')[1] | default(999)
            | int(999) if afternoon_tariff_str else 999 %}\n{# Hysteresis Logic (10%)
            #}   {%- set afternoon_is_better = afternoon_price < (night_price * 0.9)
            %}\n{# --- 4. DYNAMIC CHARGING WINDOWS --- #}  {%- set night_stop = [states('input_datetime.solax_night_charge_stop'),
            states('input_datetime.solax_night_charge_cheap_stop')] | map('as_timestamp')
            | max %}  {%- set afternoon_start = as_timestamp(states('input_datetime.solax_day_charge_start'))
            %} {%- set afternoon_stop = as_timestamp(states('input_datetime.solax_day_charge_stop'))
            %}\n{%- if afternoon_is_better %}\n  {%- set ts_maximize_start, ts_minimize_start
            = afternoon_stop, night_stop %}\n{%- else %}\n  {%- set ts_maximize_start,
            ts_minimize_start = night_stop, afternoon_stop %}\n{%- endif %}\n{# ---
            5. SIMULATE MAXIMIZE (The Cheaper Interval) --- #}  {# Goal: Charge as
            much as possible minus expected solar gain, never hitting 100% #} {%-
            set full = namespace(max=0, min=0, batt_kw=0) %}   {%- for r in forecast_data
            if as_timestamp(r.period_start) >= ts_maximize_start %}\n  {%- set pv_est
            = r.pv_estimate | float(0) %}\n  {%- set pv_low = r.pv_estimate10 | default(pv_est)
            | float(0) %}\n  {%- set pv_safe = (pv_est * w_p50) + (pv_low * w_p10)
            %}\n  \n  {%- set full.batt_kw = full.batt_kw + pv_safe - average_energy
            %}\n  {%- set full.max = [full.max, full.batt_kw] | max %}\n  {%- set
            full.min = [full.min, full.batt_kw] | min %}\n{%- endfor %}\n{%- set min_charge_needed
            = (0 - full.min) if full.min < 0 else 0 %}  {%- set max_charge_possible
            = usable_max_kw - full.max - f_offset %}\n{# Prioritize filling up to
            the max safe limit, but guarantee survival #}  {%- set TargetMaximizeKW
            = [[max_charge_possible, min_charge_needed] | max, usable_max_kw] | min
            %}\n{# --- 6. SIMULATE MINIMIZE (The Expensive Interval) --- #}  {# Goal:
            Charge as little as possible to safely reach the next cheap window #}
            \ {%- set bare = namespace(max=0, min=0, batt_kw=-b_offset) %}   {%- for
            r in forecast_data if as_timestamp(r.period_start) >= ts_minimize_start
            %}\n  {%- set ts = as_timestamp(r.period_start) %}\n  {# Only simulate
            the gap until the start of the next main charging window #}\n  {%- if
            (ts_minimize_start < ts_maximize_start and ts <= ts_maximize_start) or
            ts_minimize_start > ts_maximize_start %}\n    {%- set pv_est = r.pv_estimate
            | float(0) %}\n    {%- set pv_low = r.pv_estimate10 | default(pv_est)
            | float(0) %}\n    {%- set pv_safe = (pv_est * w_p50) + (pv_low * w_p10)
            %}\n    \n    {%- set bare.batt_kw = bare.batt_kw + pv_safe - average_energy
            %}\n    {%- set bare.max = [bare.max, bare.batt_kw] | max %}\n  {%- endif
            %}\n  {%- set bare.min = [bare.min, bare.batt_kw] | min %}\n{%- endfor
            %}\n{%- set TargetMinimizeKW = [[(0 - bare.min), 0] | max, usable_max_kw]
            | min %}\n{# --- 7. CALCULATED SOLAR OFFSET (During Afternoon Charge)
            --- #}  {%- set window = namespace(excess=0) %}  {%- for r in forecast_data
            if afternoon_start <= as_timestamp(r.period_start) < afternoon_stop %}\n
            \ {%- set pv_est = r.pv_estimate | float(0) %}\n  {%- set pv_low = r.pv_estimate10
            | default(pv_est) | float(0) %}\n  {%- set pv_safe = (pv_est * w_p50)
            + (pv_low * w_p10) %}\n  {%- set net = pv_safe - average_energy %}\n  {%-
            if net > 0 %}\n    {%- set window.excess = window.excess + net %}\n  {%-
            endif %}\n{%- endfor %}\n{# --- 8. ASSIGNMENT, EFFICIENCY LOSS & CLAMPING
            --- #}   {%- set TargetMaximizeKW = TargetMaximizeKW * 1.1 %}   {%- set
            TargetMinimizeKW = TargetMinimizeKW * 1.1 %}\n{%- if afternoon_is_better
            %}\n  {%- set target_night_kw = TargetMinimizeKW %}\n  {%- set target_afternoon_kw
            = [TargetMaximizeKW - window.excess, 0] | max %}\n{%- else %}\n  {%- set
            target_night_kw = TargetMaximizeKW %}\n  {%- set target_afternoon_kw =
            [TargetMinimizeKW - window.excess, 0] | max %}\n{%- endif %}\n{# Convert
            to percentages and strictly clamp between 11% and 90% #}  {%- set batt_night
            = [[(target_night_kw * pct_per_kw + min_soc) | round(0), min_soc] | max,
            max_soc] | min %}  {%- set batt_afternoon = [[(target_afternoon_kw * pct_per_kw
            + min_soc) | round(0), min_soc] | max, max_soc] | min %}\n{# --- 9. FINAL
            OUTPUT --- #}   {{ batt_night | int }}|{{ batt_afternoon | int }}|{{ full.max
            | round(3) }}|{{ full.min | round(3) }}|{{ TargetMinimizeKW | round(3)
            }}|{{ (full.max - full.min - 10) | round(3) }}\n"
        enabled: true
        action: input_text.set_value
      - target:
          entity_id:
          - input_number.new_battery_target
        data:
          value: '{{ states(''input_text.solar_calculations'').split(''|'')[0] | int
            }}

            '
        enabled: true
        action: input_number.set_value
      - target:
          entity_id:
          - input_number.new_day_battery_target
        data:
          value: '{{ states(''input_text.solar_calculations'').split(''|'')[1] | int
            }}

            '
        enabled: true
        action: input_number.set_value
      - alias: Log Calculation Results
        action: notify.send_message
        target:
          entity_id: notify.solax_log
        data:
          message: 'Forecast recalculation complete. Night target set to {{ states(''input_number.new_battery_target'')
            }}%. Day target set to {{ states(''input_number.new_day_battery_target'')
            }}%.

            '
    - conditions:
      - condition: trigger
        id: ''
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to battery target
        if:
        - condition: template
          value_template: '{{ states(''number.solax_selfuse_discharge_min_soc'') |
            int(11) != states(''input_number.new_battery_target'') | int(11) }}'
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set minimum soc charge
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_discharge_min_soc
          data:
            value: '{{ states(''input_number.new_battery_target'') | int }}'
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Preventing nighttime discharge. Unlocked inverter and successfully
              set Minimum SOC to {{ states('input_number.new_battery_target') }}%.
    - conditions:
      - condition: trigger
        id: ''
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to day battery target
        if:
        - condition: template
          value_template: '{{ states(''number.solax_selfuse_discharge_min_soc'') |
            int(11) != states(''input_number.new_day_battery_target'') | int(11) }}'
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set minimum soc charge
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_discharge_min_soc
          data:
            value: '{{ states(''input_number.new_day_battery_target'') | int }}'
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Preventing daytime discharge. Unlocked inverter and successfully
              set Minimum SOC to {{ states('input_number.new_day_battery_target')
              }}%.
    - conditions:
      - condition: time
        after: input_datetime.solax_night_charge_start
        before: input_datetime.solax_night_charge_stop
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: input_number.new_battery_target
      sequence:
      - alias: Checks and sets battery charge target
        if:
        - condition: template
          value_template: '{{ states(''number.solax_selfuse_nightcharge_upper_soc'')|
            int(60) != states(''input_number.new_battery_target'')| int(60) }}'
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set new charging battery target
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_nightcharge_upper_soc
          data:
            value: '{{ states(''input_number.new_battery_target'') | int(60) }}'
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Night charging window active. Unlocked inverter and set Upper
              SOC Target to {{ states('input_number.new_battery_target') }}%.
      - alias: Checks and sets battery charge start time
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: time.solax_inverter_charger_start_time_1
            state: '22:00:00'
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set Charging start time
          action: time.set_value
          target:
            entity_id: time.solax_inverter_charger_start_time_1
          data:
            time: '22:00:00'
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Night charging enabled. Set Start Time to 22:00.
    - conditions:
      - condition: and
        conditions:
        - condition: template
          value_template: '{{ now() > states(''input_datetime.solax_night_charge_cheap_stop'')
            | as_datetime | as_local }}'
        - condition: template
          value_template: '{{ now() > states(''input_datetime.solax_night_charge_stop'')
            | as_datetime | as_local }}'
        - condition: template
          value_template: '{{ now() < states(''input_datetime.solax_day_charge_start'')
            | as_datetime | as_local }}'
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: number.solax_selfuse_discharge_min_soc
          above: 11
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set minimum charge to 11
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_discharge_min_soc
          data:
            value: 11
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Night charging window ended. Unlocked inverter and reset Minimum
              SOC to 11%.
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: time.solax_inverter_charger_start_time_1
            state: 08:00:00
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: disable charging
          action: time.set_value
          target:
            entity_id: time.solax_inverter_charger_start_time_1
          data:
            time: 08:00:00
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Disabled grid charging. Reset Start Time to 08:00.
    - conditions:
      - condition: time
        after: input_datetime.solax_day_charge_start
        before: input_datetime.solax_day_charge_stop
        enabled: true
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: input_number.new_day_battery_target
        enabled: true
      sequence:
      - alias: Checks and sets battery charge target
        if:
        - condition: template
          value_template: '{{ states(''number.solax_selfuse_nightcharge_upper_soc'')|
            int(60) != states(''input_number.new_day_battery_target'')| int(60) }}'
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set new charging battery target
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_nightcharge_upper_soc
          data:
            value: '{{ states(''input_number.new_day_battery_target'') | int(60) }}'
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Day charging window active. Unlocked inverter and set Upper SOC
              Target to {{ states('input_number.new_day_battery_target') }}%.
      - alias: Checks and sets battery charge start
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: time.solax_inverter_charger_start_time_1
            state: '10:00:00'
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set Charging start time
          action: time.set_value
          target:
            entity_id: time.solax_inverter_charger_start_time_1
          data:
            time: '10:00:00'
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Day charging enabled. Set Start Time to 10:00.
    - conditions:
      - condition: template
        value_template: '{{ now() > states(''input_datetime.solax_day_charge_stop'')
          | as_datetime | as_local }}'
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: number.solax_selfuse_discharge_min_soc
          above: 11
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set minimum charge to 11
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_discharge_min_soc
          data:
            value: 11
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Day charging window ended. Unlocked inverter and reset Minimum
              SOC to 11%.
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: time.solax_inverter_charger_start_time_1
            state: 08:00:00
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: disable charging
          action: time.set_value
          target:
            entity_id: time.solax_inverter_charger_start_time_1
          data:
            time: 08:00:00
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Disabled grid charging. Reset Start Time to 08:00.
    - conditions:
      - condition: time
        after: input_datetime.solax_day_charge_start
        before: input_datetime.solax_day_charge_stop
        enabled: true
      - condition: trigger
        id:
        - Battery full
        enabled: false
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: number.solax_selfuse_discharge_min_soc
          above: 11
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: Set minimum charge to 11
          action: number.set_value
          target:
            entity_id: number.solax_selfuse_discharge_min_soc
          data:
            value: 11
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Battery hit 94% threshold. Unlocked inverter and dropped Minimum
              SOC back to 11%.
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: time.solax_inverter_charger_start_time_1
            state: 08:00:00
        then:
        - alias: Wake & Unlock Inverter
          action: button.press
          target:
            entity_id: button.solax_battery_awaken
        - delay:
            seconds: 2
        - action: select.select_option
          target:
            entity_id: select.solax_device_lock
          data:
            option: Unlock Advanced
        - delay:
            seconds: 2
        - alias: disable charging
          action: time.set_value
          target:
            entity_id: time.solax_inverter_charger_start_time_1
          data:
            time: 08:00:00
        - alias: Log Action
          action: notify.send_message
          target:
            entity_id: notify.solax_log
          data:
            message: Battery hit 94% threshold. Aborting grid charge by setting Start
              Time to 08:00.
  mode: queued
  max: 10
