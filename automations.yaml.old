- id: '1741030655730'
  alias: Automation Luz Patio
  description: ''
  triggers:
  - type: turned_on
    device_id: e85857ab7aa94ca4aa84d72e592e6937
    entity_id: f1b042112f3225e0b0ecab395ad19b3e
    domain: light
    trigger: device
    id: Luz Patio on
  - event_type: timer.finished
    event_data:
      entity_id: timer.timer_luz_patio
    trigger: event
    id: timer finished
  - type: opened
    device_id: 25403fb23324456a9a34fc5240aec7d1
    entity_id: b6480ce396c51443ad415e1040c7e533
    domain: binary_sensor
    trigger: device
    id: Patio Door Opened
  - type: turned_off
    device_id: e85857ab7aa94ca4aa84d72e592e6937
    entity_id: f1b042112f3225e0b0ecab395ad19b3e
    domain: light
    trigger: device
    id: Luz Patio Off
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Luz Patio on
      sequence:
      - action: timer.start
        metadata: {}
        data:
          duration: 01:00:00
        target:
          entity_id: timer.timer_luz_patio
    - conditions:
      - condition: trigger
        id:
        - timer finished
      sequence:
      - type: turn_off
        device_id: e85857ab7aa94ca4aa84d72e592e6937
        entity_id: f1b042112f3225e0b0ecab395ad19b3e
        domain: light
    - conditions:
      - condition: trigger
        id:
        - Patio Door Opened
      - condition: state
        entity_id: timer.timer_luz_patio
        state: idle
      - condition: or
        conditions:
        - condition: state
          entity_id: sensor.weatherstation_solar_lux
          state: unavailable
        - condition: state
          entity_id: sensor.weatherstation_solar_lux
          state: unknown
        - condition: numeric_state
          entity_id: sensor.weatherstation_solar_lux
          below: 100
      sequence:
      - action: timer.start
        metadata: {}
        data:
          duration: 00:15:00
        target:
          entity_id: timer.timer_luz_patio
      - type: turn_on
        device_id: e85857ab7aa94ca4aa84d72e592e6937
        entity_id: f1b042112f3225e0b0ecab395ad19b3e
        domain: light
        brightness_pct: 100
      - wait_for_trigger:
        - type: turned_on
          device_id: e85857ab7aa94ca4aa84d72e592e6937
          entity_id: f1b042112f3225e0b0ecab395ad19b3e
          domain: light
          trigger: device
        timeout:
          hours: 0
          minutes: 0
          seconds: 5
          milliseconds: 0
      alias: If triggered by Patio Door Opened and Timer Idle
    - conditions:
      - condition: trigger
        id:
        - Luz Patio Off
      - condition: state
        entity_id: timer.timer_luz_patio
        state: active
      sequence:
      - action: timer.cancel
        metadata: {}
        data: {}
        target:
          entity_id: timer.timer_luz_patio
      alias: If triggered by Luz Patio Off and Timer Active
  mode: single
