- id: '1704138035442'
  alias: HA start actions
  description: ''
  trigger:
  - platform: homeassistant
    event: start
  condition: []
  action:
  - delay:
      hours: 0
      minutes: 0
      seconds: 30
      milliseconds: 0
  - service: homeassistant.update_entity
    target:
      entity_id: sensor.solax_rest_local_settings
    data: {}
  mode: single
- id: '1704327208085'
  alias: Updates solar forecast
  description: ''
  trigger:
  - platform: time_pattern
    hours: /2
    minutes: '0'
    seconds: '0'
  condition:
  - condition: time
    after: 05:59:00
    before: '22:01:00'
  action:
  - service: solcast_solar.update_forecasts
    data: {}
  mode: single
- id: '1704330555876'
  alias: Change Energy Tarifs
  description: ''
  trigger:
  - platform: time
    at: 08:00:00
    variables:
      tariff: peak
      tariffPT: pico
  - platform: time
    at: '22:00:00'
    variables:
      tariff: offpeak
      tariffPT: Fora de Vazio
  action:
  - service: select.select_option
    target:
      entity_id: select.daily_energy
    data:
      option: '{{ tariff }}'
  - service: select.select_option
    target:
      entity_id: select.bmw_ce_monthly_energy
    data:
      option: '{{ tariff }}'
  - service: select.select_option
    target:
      entity_id: select.bmw_yearly_energy
    data:
      option: '{{ tariffPT }}'
  - service: select.select_option
    target:
      entity_id: select.monthly_energy
    data:
      option: '{{ tariff }}'
  - service: select.select_option
    target:
      entity_id: select.water_heater_energy_daily
    data:
      option: '{{ tariff }}'
  - service: select.select_option
    target:
      entity_id: select.water_heater_energy_weekly
    data:
      option: '{{ tariff }}'
  - service: select.select_option
    target:
      entity_id: select.water_heater_energy_monthly
    data:
      option: '{{ tariff }}'
  mode: single
- id: '1706317008926'
  alias: Automation Light Escadas Garagem
  description: ''
  triggers:
  - entity_id:
    - switch.switch_escadas_garagem
    to: 'on'
    for:
      hours: 0
      minutes: 0
      seconds: 0
    id: switched.on
    trigger: state
  - event_type: timer.finished
    event_data:
      entity_id: timer.luz_escadas_garagem
    id: timer.finished
    trigger: event
  - entity_id:
    - binary_sensor.0x00158d000447584c_occupancy
    to: 'on'
    from:
    id: movement.detected
    for:
      hours: 0
      minutes: 0
      seconds: 0
    trigger: state
  - entity_id:
    - switch.switch_escadas_garagem
    to: 'off'
    for:
      hours: 0
      minutes: 0
      seconds: 0
    id: switched.off
    trigger: state
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - movement.detected
      sequence:
      - if:
        - condition: device
          type: is_off
          device_id: 2620614be1c0d9233bc0f767866accc4
          entity_id: 0636c1ccfa09b163f634c1e41e0cdcab
          domain: switch
        then:
        - data:
            duration: 00:02:00
          action: timer.start
          target:
            entity_id: timer.luz_escadas_garagem
        - type: turn_on
          device_id: 2620614be1c0d9233bc0f767866accc4
          entity_id: 0636c1ccfa09b163f634c1e41e0cdcab
          domain: switch
          enabled: false
        - wait_for_trigger:
          - type: turned_on
            device_id: 2620614be1c0d9233bc0f767866accc4
            entity_id: 0636c1ccfa09b163f634c1e41e0cdcab
            domain: switch
            trigger: device
          timeout:
            hours: 0
            minutes: 0
            seconds: 1
            milliseconds: 0
          enabled: false
        else:
        - data:
            duration: 00:02:00
          action: timer.start
          target:
            entity_id: timer.luz_escadas_garagem
    - conditions:
      - condition: trigger
        id:
        - switched.on
      sequence:
      - data:
          duration: 00:02:00
        action: timer.start
        target:
          entity_id: timer.luz_escadas_garagem
    - conditions:
      - condition: trigger
        id:
        - timer.finished
      sequence:
      - type: turn_off
        device_id: 2620614be1c0d9233bc0f767866accc4
        entity_id: 0636c1ccfa09b163f634c1e41e0cdcab
        domain: switch
      - wait_for_trigger:
        - type: turned_off
          device_id: 2620614be1c0d9233bc0f767866accc4
          entity_id: 0636c1ccfa09b163f634c1e41e0cdcab
          domain: switch
          trigger: device
        timeout:
          hours: 0
          minutes: 0
          seconds: 1
          milliseconds: 0
    - conditions:
      - condition: trigger
        id:
        - switched.off
      sequence:
      - data: {}
        action: timer.cancel
        target:
          entity_id: timer.luz_escadas_garagem
  mode: single
- id: '1706828856750'
  alias: Freeds MQTT update
  description: ''
  trigger:
  - platform: state
    entity_id:
    - sensor.main_power_meter_3_1_2
    attribute: V_WATT
    id: Power change
  - platform: state
    entity_id:
    - sensor.freeds_water_temp
    id: Water temp change
  condition: []
  action:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Power change
      sequence:
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/GridWatts
          qos: 0
          payload_template: '{{ states(''sensor.main_power_meter_3_1_2'') }}'
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/MPPT1_Watts
          qos: 0
          payload_template: '{{ states(''sensor.solax_local_pv1_output'') }}'
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/MPPT2_Watts
          qos: 0
          payload_template: '{{ states(''sensor.solax_local_pv2_output'') }}'
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/PvWattsTotal
          qos: 0
          payload_template: '{{ states(''sensor.solax_local_pv_output'') }}'
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/BatterySOC
          qos: 0
          payload_template: '{{ states(''sensor.solax_local_battery_soc'') }}'
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/LoadWatts
          qos: 0
          payload_template: '{{ states(''sensor.solax_local_ac_power'') }}'
      - service: mqtt.publish
        data:
          retain: true
          topic: Inverter/BatteryWatts
          qos: 0
          payload_template: '{{ states(''sensor.solax_local_battery_power'') }}'
    - conditions:
      - condition: trigger
        id:
        - Water temp change
      sequence: []
  mode: single
- id: '1708009852571'
  alias: 'Automation Luz Garagem '
  description: ''
  triggers:
  - entity_id:
    - switch.switch_garagem_left
    to: 'on'
    for:
      hours: 0
      minutes: 0
      seconds: 0
    id: switched.on
    trigger: state
    from: 'off'
  - entity_id:
    - switch.switch_garagem_left
    to: 'off'
    for:
      hours: 0
      minutes: 0
      seconds: 0
    id: switched.off
    trigger: state
    from: 'on'
  - event_type: timer.finished
    event_data:
      entity_id: timer.luz_garagem
    id: timer.finished
    trigger: event
  - entity_id:
    - binary_sensor.gms2_occupancy
    - binary_sensor.gms3_occupancy
    - binary_sensor.gms4_occupancy
    to: 'on'
    from:
    id: movement.detected
    for:
      hours: 0
      minutes: 0
      seconds: 0
    trigger: state
  - entity_id:
    - cover.garage_door
    from: closed
    to: open
    id: garage door opening
    trigger: state
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - movement.detected
        - garage door opening
      sequence:
      - data:
          duration: 0:05:00
        target:
          entity_id: timer.luz_garagem
        action: timer.start
      - target:
          entity_id:
          - switch.switch_garagem_left
        data: {}
        action: switch.turn_on
      - delay:
          hours: 0
          minutes: 0
          seconds: 1
          milliseconds: 0
    - conditions:
      - condition: trigger
        id:
        - switched.on
      sequence:
      - target:
          entity_id: timer.luz_garagem
        data:
          duration: 0:60:00
        action: timer.start
    - conditions:
      - condition: trigger
        id:
        - timer.finished
      sequence:
      - if:
        - condition: or
          conditions:
          - type: is_occupied
            condition: device
            device_id: c83bf02266c0072a5095faf87f30e7ff
            entity_id: f78176e50df30b44e9d613f1bab89163
            domain: binary_sensor
          - type: is_occupied
            condition: device
            device_id: 11a956c8bccc452f588ad616c53975be
            entity_id: 64618d8ef80cfc16ce38a84945de8e74
            domain: binary_sensor
          - type: is_occupied
            condition: device
            device_id: fa0c138647aca8e3800cc5e9e1f70c66
            entity_id: 6ca0ff082cdfcee89eb8e84ad4a19fa7
            domain: binary_sensor
        then:
        - target:
            entity_id: timer.luz_garagem
          data:
            duration: 0:05:00
          action: timer.start
        else:
        - target:
            entity_id:
            - switch.switch_garagem_left
          data: {}
          action: switch.turn_off
    - conditions:
      - condition: trigger
        id:
        - switched.off
      sequence:
      - target:
          entity_id: timer.luz_garagem
        data: {}
        action: timer.cancel
  mode: single
- id: '1708298931183'
  alias: Water Heater Management
  description: ''
  triggers:
  - entity_id:
    - sensor.sonoff_1001dabf03_temperature
    - input_number.water_heater_minimum_target
    - input_number.water_heater_maximum_target
    - input_number.water_heater_dinner_target
    - input_boolean.no_water_heating
    id: water temperature change
    trigger: state
  - at: input_datetime.night_water_heating_start
    trigger: time
  - at: input_datetime.night_water_heating_stop
    trigger: time
  - at: input_datetime.late_afternoon_water_heating_start
    trigger: time
  - at: input_datetime.late_afternoon_water_heating_stop
    trigger: time
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: state
        entity_id: input_boolean.no_water_heating
        state: 'on'
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'on'
        then:
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.automatic_aqs_switch
          action: input_boolean.turn_off
      alias: Disable water warming
    - conditions:
      - condition: time
        after: input_datetime.night_water_heating_start
        before: input_datetime.night_water_heating_stop
      - condition: or
        conditions:
        - condition: numeric_state
          entity_id: sensor.sonoff_1001dabf03_temperature
          below: input_number.water_heater_maximum_target
        - condition: template
          value_template: '{{ (( as_timestamp(now()) - state_attr(''input_datetime.last_high_water_temp'',
            ''timestamp''))  / 86400) | round() > 30 }}'
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'off'
        then:
        - target:
            entity_id:
            - input_boolean.automatic_aqs_switch
          data: {}
          action: input_boolean.turn_on
      alias: night water too cold, start
    - conditions:
      - condition: time
        after: input_datetime.night_water_heating_start
        before: input_datetime.night_water_heating_stop
      - condition: and
        conditions:
        - condition: numeric_state
          entity_id: sensor.sonoff_1001dabf03_temperature
          above: input_number.water_heater_maximum_target
          value_template: '{{ float (state.state) -2 }}'
        - condition: template
          value_template: '{{ not (( as_timestamp(now()) - state_attr(''input_datetime.last_high_water_temp'',
            ''timestamp''))  / 86400) | round() > 30 }}'
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'on'
        then:
        - target:
            entity_id:
            - input_boolean.automatic_aqs_switch
          data: {}
          action: input_boolean.turn_off
      alias: night water too hot, stop
    - conditions:
      - condition: time
        after: input_datetime.late_afternoon_water_heating_start
        before: input_datetime.late_afternoon_water_heating_stop
      - condition: numeric_state
        entity_id: sensor.sonoff_1001dabf03_temperature
        below: input_number.water_heater_dinner_target
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'off'
        then:
        - target:
            entity_id:
            - input_boolean.automatic_aqs_switch
          data: {}
          action: input_boolean.turn_on
      alias: late afternoon water too cold, start
    - conditions:
      - condition: time
        after: input_datetime.late_afternoon_water_heating_start
        before: input_datetime.late_afternoon_water_heating_stop
      - condition: numeric_state
        entity_id: sensor.sonoff_1001dabf03_temperature
        above: input_number.water_heater_dinner_target
        value_template: '{{ float (state.state) -2 }}'
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'on'
        then:
        - target:
            entity_id:
            - input_boolean.automatic_aqs_switch
          data: {}
          action: input_boolean.turn_off
      alias: Late afternoon water too hot, stop
    - conditions:
      - condition: numeric_state
        entity_id: sensor.sonoff_1001dabf03_temperature
        below: input_number.water_heater_minimum_target
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'off'
        then:
        - target:
            entity_id:
            - input_boolean.automatic_aqs_switch
          data: {}
          action: input_boolean.turn_on
      alias: Water too cold heat
    - conditions:
      - condition: numeric_state
        entity_id: sensor.sonoff_1001dabf03_temperature
        above: input_number.water_heater_minimum_target
        value_template: '{{ float (state.state) -2 }}'
      - condition: not
        conditions:
        - condition: time
          after: input_datetime.night_water_heating_start
          before: input_datetime.night_water_heating_stop
      sequence:
      - if:
        - condition: state
          entity_id: input_boolean.automatic_aqs_switch
          state: 'on'
        then:
        - target:
            entity_id:
            - input_boolean.automatic_aqs_switch
          data: {}
          action: input_boolean.turn_off
      alias: water too hot, stop
  - if:
    - condition: numeric_state
      entity_id: sensor.sonoff_1001dabf03_temperature
      above: 65
    then:
    - action: input_datetime.set_datetime
      metadata: {}
      data:
        timestamp: '{{ now().timestamp() }}'
      target:
        entity_id: input_datetime.last_high_water_temp
  mode: queued
  max: 10
- id: '1708713934300'
  alias: Update SQL values
  description: ''
  trigger:
  - platform: time_pattern
