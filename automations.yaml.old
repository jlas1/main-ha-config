- id: '1755862269838'
  alias: Ev Charger Reset
  description: ''
  triggers:
  - trigger: template
    value_template: '{{ states(''sensor.ev_charger_status'') == ''waiting'' }}'
    id: EV charger waiting
    for:
      hours: 0
      minutes: 0
      seconds: 10
  conditions: []
  actions:
  - if:
    - condition: or
      conditions:
      - condition: state
        entity_id: input_boolean.manual_override_ve_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.automatic_ve_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.grid_injection_avoidance_ve_switch
        state: 'on'
    then:
    - type: turn_off
      device_id: cb0512f084dfe73bb627d29df25f74c4
      entity_id: 773bc18359c530b24d91098ccc9f8413
      domain: switch
    - delay:
        hours: 0
        minutes: 0
        seconds: 5
        milliseconds: 0
    - type: turn_on
      device_id: cb0512f084dfe73bb627d29df25f74c4
      entity_id: 773bc18359c530b24d91098ccc9f8413
      domain: switch
  mode: single
