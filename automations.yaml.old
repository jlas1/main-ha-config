- id: '1713279395912'
  alias: SOLAX grid test
  description: ''
  trigger:
  - platform: numeric_state
    entity_id:
    - sensor.solax_local_battery_soc
    above: 95
    id: Trigger VE
    for:
      hours: 0
      minutes: 1
      seconds: 0
  - platform: numeric_state
    entity_id:
    - sensor.solax_local_battery_soc
    above: 94
    id: Tigger AQS
    for:
      hours: 0
      minutes: 1
      seconds: 0
  - platform: numeric_state
    entity_id:
    - sensor.solax_local_battery_soc
    id: Disable VE
    below: 93
    for:
      hours: 0
      minutes: 1
      seconds: 0
  - platform: numeric_state
    entity_id:
    - sensor.solax_local_battery_soc
    id: Disable AQS
    below: 92
    for:
      hours: 0
      minutes: 1
      seconds: 0
  - platform: state
    entity_id:
    - sensor.sonoff_1001dabf03_temperature
    - sensor.solax_local_battery_soc
    enabled: false
  condition:
  - condition: numeric_state
    entity_id: sensor.solax_local_battery_soc
    above: 80
  action:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Tigger AQS
      - condition: numeric_state
        entity_id: sensor.solar_panels_v2_power
        above: sensor.solax_local_total_home_use
      sequence:
      - service: input_boolean.turn_on
        metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
    - conditions:
      - condition: or
        conditions:
        - condition: and
          conditions:
          - condition: numeric_state
            entity_id: sensor.sonoff_1001dabf03_temperature
            above: input_number.water_heater_dinner_target
          - condition: numeric_state
            entity_id: sensor.solax_local_battery_soc
            above: 93
        - condition: and
          conditions:
          - condition: numeric_state
            entity_id: sensor.solar_panels_v2_power
            above: sensor.solax_local_total_home_use
          - condition: trigger
            id:
            - Trigger VE
      sequence:
      - service: input_boolean.turn_on
        metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve_switch
    - conditions:
      - condition: trigger
        id:
        - Disable VE
      sequence:
      - alias: Disable VE if On
        if:
        - condition: state
          entity_id: input_boolean.grid_injection_avoidance_ve_switch
          state: 'on'
          for:
            hours: 0
            minutes: 0
            seconds: 0
        then:
        - service: input_boolean.turn_off
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_ve_switch
    - conditions:
      - condition: trigger
        id:
        - Disable AQS
      sequence:
      - alias: Disable AQS if On
        if:
        - condition: state
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
          state: 'on'
        then:
        - service: input_boolean.turn_off
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_aqs_switch
    - conditions:
      - condition: and
        conditions:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_soc
          above: 81
        - condition: numeric_state
          entity_id: sensor.solcast_pv_forecast_forecast_remaining_today
          above: 7
        - condition: template
          value_template: '{{ states(''input_text.solar_calculations'').split(''|'')[1]|int
            > 15 }}'
      sequence:
      - alias: Enable VE if Off
        if:
        - condition: state
          entity_id: input_boolean.grid_injection_avoidance_ve_switch
          state: 'off'
        then:
        - service: input_boolean.turn_on
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_ve_switch
      alias: When Solar production is high and battery >80
    - conditions:
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: 81
      sequence:
      - alias: Disable VE if On
        if:
        - condition: state
          entity_id: input_boolean.grid_injection_avoidance_ve_switch
          state: 'on'
        then:
        - service: input_boolean.turn_off
          target:
            entity_id:
            - input_boolean.grid_injection_avoidance_ve_switch
          data: {}
      alias: When Solar production is high and battery >80
  mode: single
- id: '1721774385824'
  alias: AC Automatic Mode
  description: ''
  triggers:
  - entity_id:
    - input_boolean.automation_start_rooms_ac
    id: Start rooms
    from: 'off'
    to: 'on'
    trigger: state
  - entity_id:
    - input_boolean.automation_start_rooms_ac
    id: Stop rooms2
    from: 'on'
    to: 'off'
    trigger: state
    enabled: true
  - entity_id:
    - input_boolean.automation_start_livingroom_ac
    id: 'Start LivingRoom '
    from: 'off'
    to: 'on'
    trigger: state
    enabled: true
  - entity_id:
    - input_boolean.automation_start_livingroom_ac
    id: 'Stop LivingRoom '
    from: 'on'
    to: 'off'
    trigger: state
    enabled: true
  - entity_id:
    - timer.top_ac_timer
    to: idle
    from: active
    id: Timer Top stopped
    trigger: state
  - entity_id:
    - timer.bottom_ac_timer
    from: active
    to: idle
    id: Timer Bottom stopped
    trigger: state
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Start rooms
      sequence:
      - alias: Turn ON Rooms AC (1st attempt)
        metadata: {}
        data: {}
        target:
          entity_id:
          - climate.lara_ac_control
          - climate.quarto_lucas_ac
          - climate.suite_ac
        action: climate.turn_on
      - alias: Wait 1 second
        delay:
          seconds: 1
      - alias: Turn ON Rooms AC (2nd attempt)
        metadata: {}
        data: {}
        target:
          entity_id:
          - climate.lara_ac_control
          - climate.quarto_lucas_ac
          - climate.suite_ac
        action: climate.turn_on
      - alias: Start Top AC Timer
        metadata: {}
        data: {}
        target:
          entity_id: timer.top_ac_timer
        action: timer.start
    - conditions:
      - condition: trigger
        id:
        - Stop rooms2
      sequence:
      - alias: Check if Top AC Timer is idle
        if:
        - condition: state
          entity_id: timer.top_ac_timer
          state: idle
        then:
        - alias: Turn OFF Rooms AC (1st attempt)
          target:
            entity_id:
            - climate.lara_ac_control
            - climate.quarto_lucas_ac
            - climate.suite_ac
          data: {}
          action: climate.turn_off
        - alias: Wait 1 second
          delay:
            seconds: 1
        - alias: Turn OFF Rooms AC (2nd attempt)
          target:
            entity_id:
            - climate.lara_ac_control
            - climate.quarto_lucas_ac
            - climate.suite_ac
          data: {}
          action: climate.turn_off
    - conditions:
      - condition: trigger
        id:
        - Timer Top stopped
      sequence:
      - alias: Check if Rooms AC automation is OFF
        if:
        - condition: state
          entity_id: input_boolean.automation_start_rooms_ac
          state: 'off'
        then:
        - alias: Turn OFF Rooms AC (1st attempt)
          target:
            entity_id:
            - climate.lara_ac_control
            - climate.quarto_lucas_ac
            - climate.suite_ac
          data: {}
          action: climate.turn_off
        - alias: Wait 1 second
          delay:
            seconds: 1
        - alias: Turn OFF Rooms AC (2nd attempt)
          target:
            entity_id:
            - climate.lara_ac_control
            - climate.quarto_lucas_ac
            - climate.suite_ac
          data: {}
          action: climate.turn_off
    - conditions:
      - condition: trigger
        id:
        - 'Start LivingRoom '
      sequence:
      - alias: Turn ON Living Room AC (1st attempt)
        metadata: {}
        data: {}
        target:
          entity_id:
          - climate.dinner_ac
          - climate.tv_ac
        action: climate.turn_on
      - alias: Wait 1 second
        delay:
          seconds: 1
      - alias: Turn ON Living Room AC (2nd attempt)
        metadata: {}
        data: {}
        target:
          entity_id:
          - climate.dinner_ac
          - climate.tv_ac
        action: climate.turn_on
      - alias: Start Bottom AC Timer
        metadata: {}
        data: {}
        target:
          entity_id: timer.bottom_ac_timer
        action: timer.start
    - conditions:
      - condition: trigger
        id:
        - 'Stop LivingRoom '
      sequence:
      - alias: Check if Bottom AC Timer is idle
        if:
        - condition: state
          entity_id: timer.bottom_ac_timer
          state: idle
        then:
        - alias: Turn OFF Living Room AC (1st attempt)
          data: {}
          target:
            entity_id:
            - climate.dinner_ac
            - climate.tv_ac
          action: climate.turn_off
        - alias: Wait 1 second
          delay:
            seconds: 1
        - alias: Turn OFF Living Room AC (2nd attempt)
          data: {}
          target:
            entity_id:
            - climate.dinner_ac
            - climate.tv_ac
          action: climate.turn_off
    - conditions:
      - condition: trigger
        id:
        - Timer Bottom stopped
      sequence:
      - alias: Check if Living Room AC automation is OFF
        if:
        - condition: state
          entity_id: input_boolean.automation_start_livingroom_ac
          state: 'off'
        then:
        - alias: Turn OFF Living Room AC (1st attempt)
          data: {}
          target:
            entity_id:
            - climate.dinner_ac
            - climate.tv_ac
          action: climate.turn_off
        - alias: Wait 1 second
          delay:
            seconds: 1
        - alias: Turn OFF Living Room AC (2nd attempt)
          data: {}
          target:
            entity_id:
            - climate.dinner_ac
            - climate.tv_ac
          action: climate.turn_off
  mode: queued
  max: 2
- id: '1723760622732'
  alias: Front Cover Control
  description: ''
  trigger:
  - platform: time
    at: '12:00:00'
    id: open cover
  - platform: time
    at: '19:30:00'
    id: close cover
  - type: wind_speed
    platform: device
    device_id: da21d5b4bd1c50b18ee73b26d00ee6a5
    entity_id: 582ad6941fb2eacaf1154e7489c3bb82
    domain: sensor
    above: 40
    for:
      hours: 0
      minutes: 1
      seconds: 0
    id: too windy
  condition: []
  action:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - open cover
      sequence:
      - if:
        - type: is_value
          condition: device
          device_id: da21d5b4bd1c50b18ee73b26d00ee6a5
          entity_id: d8f087b876d27c756cd34fbf961b49fb
          domain: sensor
          above: 5
        then:
        - action: cover.set_cover_position
          metadata: {}
          data:
            position: 50
          target:
            device_id: 8a3539720de0387b480bea2886bd2c93
    - conditions:
      - condition: trigger
        id:
        - close cover
        - too windy
      sequence:
      - action: cover.close_cover
        metadata: {}
        data: {}
        target:
          device_id: 8a3539720de0387b480bea2886bd2c93
  mode: single
- id: '1731493787262'
  alias: No Water Heating
  description: ''
  trigger:
  - platform: time_pattern
    minutes: /5
  condition: []
  action:
  - if:
    - condition: template
      value_template: '{{now().timetuple().tm_isdst}}'
    then:
    - if:
      - condition: template
        value_template: '{{ (today_at("07:30") < now() < today_at("10:00")) or (today_at("19:30")
          < now() < today_at("22:00")) }}'
      then:
      - action: input_boolean.turn_on
        metadata: {}
        data: {}
        target:
          entity_id: input_boolean.no_water_heating
      else:
      - action: input_boolean.turn_off
        target:
          entity_id:
          - input_boolean.no_water_heating
        data: {}
    else:
    - if:
      - condition: template
        value_template: '{{ (today_at("08:00") < now() < today_at("10:00")) or (today_at("19:30")
          < now() < today_at("22:00")) }}'
      then:
      - action: input_boolean.turn_on
        metadata: {}
        data: {}
        target:
          entity_id: input_boolean.no_water_heating
      else:
      - action: input_boolean.turn_off
        target:
          entity_id:
          - input_boolean.no_water_heating
        data: {}
  mode: single
- id: '1731581592088'
  alias: Automation Luz Escritorio
  description: ''
  triggers:
  - trigger: state
    entity_id:
    - switch.switch_escritorio_l1
    from: 'off'
    to: 'on'
    id: Swich Escritorio 1 ligado
  - trigger: state
    entity_id:
    - switch.switch_escritorio_l1
    from: 'on'
    to: 'off'
    id: Swich Escritorio 1 desligado
  - trigger: state
    entity_id:
    - switch.switch_escritorio_l2
    from: 'off'
    to: 'on'
    id: Swich Escritorio 2 ligado
  - trigger: state
    entity_id:
    - switch.switch_escritorio_l2
    from: 'on'
    to: 'off'
    id: Swich Escritorio 2 desligado
  - trigger: state
    entity_id:
    - switch.switch_garagem_center
    from: 'on'
    to: 'off'
    id: switch garagem center desligado
  - trigger: state
    entity_id:
    - switch.switch_garagem_center
    from: 'off'
    to: 'on'
    id: switch garagem center ligado
  - trigger: state
    entity_id:
    - switch.switch_garagem_right
    from: 'on'
    to: 'off'
    id: switch garagem right desligado
  - trigger: state
    entity_id:
    - switch.switch_garagem_right
    from: 'off'
    to: 'on'
    id: switch garagem Right ligado
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Swich Escritorio 1 ligado
        - switch garagem center ligado
      sequence:
      - type: turn_on
        device_id: adc12d4502c9c3026e48ed5d4b587074
        entity_id: a00f3577395b5195dcb5b42cd765aed6
        domain: switch
      - type: turn_on
        device_id: 9aa9dc644a56923487aaec62bc46a3d4
        entity_id: 40cbbdbf49b3e28bb68004a64104e471
        domain: switch
      - wait_for_trigger:
        - trigger: state
          entity_id:
          - switch.switch_garagem_center
          from: 'off'
          to: 'on'
          for:
            hours: 0
            minutes: 0
            seconds: 0
        timeout:
          hours: 0
          minutes: 0
          seconds: 0
          milliseconds: 900
      - type: turn_on
        device_id: 20dd33fcef13da099a879c34fa00fc8a
        entity_id: b5cedcbbe48616bba502416bfd82e6b5
        domain: switch
      - wait_for_trigger:
        - trigger: state
          entity_id:
          - switch.switch_escritorio_l1
          from: 'off'
          to: 'on'
          for:
            hours: 0
            minutes: 0
            seconds: 0
        timeout:
          hours: 0
          minutes: 0
          seconds: 0
          milliseconds: 900
    - conditions:
      - condition: trigger
        id:
        - Swich Escritorio 1 desligado
        - switch garagem center desligado
      sequence:
      - type: turn_off
        device_id: adc12d4502c9c3026e48ed5d4b587074
        entity_id: a00f3577395b5195dcb5b42cd765aed6
        domain: switch
      - type: turn_off
        device_id: 9aa9dc644a56923487aaec62bc46a3d4
        entity_id: 40cbbdbf49b3e28bb68004a64104e471
        domain: switch
      - wait_for_trigger:
        - trigger: state
          entity_id:
          - switch.switch_garagem_center
          from: 'on'
          to: 'off'
          for:
            hours: 0
            minutes: 0
            seconds: 0
        timeout:
          hours: 0
          minutes: 0
          seconds: 0
          milliseconds: 900
      - type: turn_off
