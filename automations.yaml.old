- id: '1709329859277'
  alias: Manual Switch Automation
  description: ''
  triggers:
  - domain: mqtt
    device_id: 9cd169e09a32f883ac5119366ec3e818
    id: single toggle Lara
    type: action
    subtype: single
    trigger: device
  - domain: mqtt
    device_id: 9cd169e09a32f883ac5119366ec3e818
    id: double toggle Lara
    type: action
    subtype: double
    trigger: device
  - domain: mqtt
    device_id: 9cd169e09a32f883ac5119366ec3e818
    id: hold toggle Lara
    type: action
    subtype: hold
    trigger: device
  - trigger: state
    entity_id:
    - timer.timer_aquece_cama_lucas
    from: active
    to: idle
    id: fim contador aquece cama Lucas
  - domain: mqtt
    device_id: 3fa995d8384d844b64eb7d166532f0f2
    type: action
    subtype: single
    trigger: device
    id: single toggle portao garagem
    alias: Single Portão Garagem
  - domain: mqtt
    device_id: b6add22cc32615420a2f3092d4ae54da
    type: action
    subtype: single
    trigger: device
    alias: Single switch cama Lucas
    id: single toggle Lucas
  - alias: double switch cama Lucas
    domain: mqtt
    device_id: b6add22cc32615420a2f3092d4ae54da
    type: action
    subtype: double
    trigger: device
    id: double toggle Lucas
  - alias: hold switch cama Lucas
    domain: mqtt
    device_id: b6add22cc32615420a2f3092d4ae54da
    type: action
    subtype: hold
    trigger: device
    id: hold toggle Lucas
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - single toggle Lara
      sequence:
      - target:
          entity_id:
          - switch.switch_quarto_lara
        data: {}
        action: switch.toggle
    - conditions:
      - condition: trigger
        id:
        - double toggle Lara
      sequence:
      - data: {}
        action: switch.toggle
        target:
          device_id: 4d1de10a2e52d1ce1cfe6a38a1811483
    - conditions:
      - condition: trigger
        id:
        - hold toggle Lara
      sequence:
      - type: toggle
        device_id: 4ec508a9f76bf7d00411603b10903aff
        entity_id: 5f38ccba53c3dc51acb20c7db6365d52
        domain: light
    - conditions:
      - condition: trigger
        id:
        - single toggle portao garagem
      sequence:
      - metadata: {}
        data: {}
        target:
          entity_id: cover.garage_door
        action: cover.toggle
    - conditions:
      - condition: trigger
        id:
        - single toggle Lucas
      sequence:
      - data: {}
        target:
          entity_id: switch.switch_quarto_lucas
        action: switch.toggle
    - conditions:
      - condition: trigger
        id:
        - double toggle Lucas
      sequence:
      - action: timer.start
        target:
          entity_id: timer.timer_aquece_cama_lucas
        data:
          duration: 00:20:00
    - conditions:
      - condition: trigger
        id:
        - fim contador aquece cama Lucas
      sequence:
      - type: turn_off
        device_id: 6e0dd6c37b71d2623e42aa6facbc7afe
        entity_id: 02661c9aa8bd55055cd76a694208c10f
        domain: switch
    - conditions:
      - condition: trigger
        id:
        - hold toggle Lucas
      sequence:
      - type: toggle
        device_id: fc9d58e1e5a004d7e35b70772da9d0d9
        entity_id: f7aa2096d0884e6d500bd3bb19d4c75d
        domain: switch
  mode: single
- id: '1709567168156'
  alias: OMIE Optimizations
  description: ''
  triggers:
  - at: '19:00:00'
    id: Prepare for night energy usage
    trigger: time
  conditions: []
  actions:
  - target:
      entity_id: input_text.automation_low_cost_coopernico
    data:
      value: "{% set sensor = 'sensor.template_coopernico_spot_price_bihorario' %}\n\n{#
        1. Extract and convert dicts to sorted lists #}\n{% set today_dict = state_attr(sensor,
        'today_hours') %}\n{% set tomorrow_dict = state_attr(sensor, 'tomorrow_hours')
        %}\n\n{% if today_dict is not none and tomorrow_dict is not none %}\n  {%
        set today_prices = today_dict.items() | sort(attribute='0') | map(attribute='1')
        | list %}\n  {% set tomorrow_prices = tomorrow_dict.items() | sort(attribute='0')
        | map(attribute='1') | list %}\n\n  {# 2. Window: Today 22:00 to Tomorrow
        08:00 (10 hours total) #}\n  {# today_prices[22:] gets 22:00 and 23:00. tomorrow_prices[:8]
        gets 00:00-07:00 #}\n  {% set window = today_prices[22:] + tomorrow_prices[:8]
        %}\n  {% set min_price = window | map('float', 1000) | min %}\n\n  {# 3. Namespaces
        for calculations #}\n  {% set ns = namespace(ts_2h='', ts_3h='', ts_5h='',
        ts_1h='', ts_start=99, ts_stop=0) %}\n\n  {# 4. Calculate best starts for
        2h, 3h, 5h, 1h (Latest occurrence) #}\n  {% for d in [2, 3, 5, 1] %}\n    {%
        set best = namespace(min_sum=999999, idx=0) %}\n    {# Backward range ensures
        latest index is picked on tie #}\n    {% for i in range((window | count -
        d), -1, -1) %}\n      {% set current_sum = window[i:i+d] | map('float', 1000)
        | sum %}\n      {% if current_sum <= best.min_sum %}\n        {% set best.min_sum
        = current_sum %}\n        {% set best.idx = i %}\n      {% endif %}\n    {%
        endfor %}\n    \n    {% set ts = (today_at(\"22:00\") + timedelta(hours=best.idx)).timestamp()
        | int | string %}\n    \n    {# Map results to the required output order #}\n
        \   {% if d == 2 %}{% set ns.ts_2h = ts %}{% endif %}\n    {% if d == 3 %}{%
        set ns.ts_3h = ts %}{% endif %}\n    {% if d == 5 %}{% set ns.ts_5h = ts %}{%
        endif %}\n    {% if d == 1 %}{% set ns.ts_1h = ts %}{% endif %}\n  {% endfor
        %}\n\n  {# 5. Calculate ts_start and ts_stop (Hours within 10% of min_price)
        #}\n  {% for i in range(window | count) %}\n    {% if window[i] is not none
        and window[i] <= (min_price * 1.1) %}\n      {% if i < ns.ts_start %}{% set
        ns.ts_start = i %}{% endif %}\n      {% if i > ns.ts_stop %}{% set ns.ts_stop
        = i %}{% endif %}\n    {% endif %}\n  {% endfor %}\n\n  {% set start_dt =
        (today_at(\"22:00\") + timedelta(hours=ns.ts_start)).timestamp() | int | string
        %}\n  {% set stop_dt = (today_at(\"22:00\") + timedelta(hours=ns.ts_stop)).timestamp()
        | int | string %}\n\n  {# 6. Final Output String matching your macro's order
        #}\n  {{ ns.ts_2h + '|' + ns.ts_3h + '|' + ns.ts_5h + '|' + ns.ts_1h + '|'
        + start_dt + '|' + stop_dt + '|' + min_price | string }}\n\n{% endif %}"
    action: input_text.set_value
  - target:
      entity_id: input_text.automation_afternoon_low_cost_coopernico
    data:
      value: "{% set sensor = 'sensor.template_coopernico_spot_price_bihorario' %}\n\n{#
        1. Determine which data to use (Fallback to today if tomorrow is missing)
        #}\n{% set tomorrow_dict = state_attr(sensor, 'tomorrow_hours') %}\n{% set
        today_dict = state_attr(sensor, 'today_hours') %}\n\n{# Check if tomorrow
        is available and has data at index 8 #}\n{% if tomorrow_dict is not none and
        tomorrow_dict.values()|list|count > 8 %}\n  {% set source_dict = tomorrow_dict
        %}\n  {% set day_offset = 1 %}\n{% else %}\n  {% set source_dict = today_dict
        %}\n  {% set day_offset = 0 %}\n{% endif %}\n\n{% if source_dict is not none
        %}\n  {# 2. Extract 08:00 to 20:00 (12 hour window) #}\n  {% set all_prices
        = source_dict.items() | sort(attribute='0') | map(attribute='1') | list %}\n
        \ {% set window = all_prices[8:20] %}\n  {% set min_price = window | map('float',
        1000) | min %}\n\n  {# 3. Search for the latest cheapest 2-hour block #}\n
        \ {% set best = namespace(min_sum=999999, idx=0) %}\n  \n  {# range(10, -1,
        -1) matches your analyzed macro's backward search (12 hours - 2 duration =
        10) #}\n  {% for i in range(10, -1, -1) %}\n    {% set current_sum = (window[i]
        | float(1000) + window[i+1] | float(1000)) / 2 %}\n    \n    {# Using <= ensures
        we pick the LATEST occurrence #}\n    {% if current_sum <= best.min_sum %}\n
        \     {% set best.min_sum = current_sum %}\n      {% set best.idx = i %}\n
        \   {% endif %}\n  {% endfor %}\n\n  {# 4. Calculate timestamp (Base 08:00
        + offset + day_offset) #}\n  {% set start_dt = (today_at(\"08:00\") + timedelta(days=day_offset)
        + timedelta(hours=best.idx)) %}\n\n  {# 5. Output: [Timestamp]|[Min Price]
        #}\n  {{ start_dt.timestamp() | int | string + \"|\" + min_price | string
        }}\n\n{% endif %}"
    action: input_text.set_value
  - target:
      entity_id: input_text.automation_low_cost_coopernico
    data:
      value: "{%- set price_map = (state_attr('sensor.template_coopernico_spot_price_bihorario','today_hours').values()|list)[22:24]
        %} {%- set price_map = price_map + (state_attr('sensor.template_coopernico_spot_price_bihorario','tomorrow_hours').values()|list)[0:8]
        %} {%- set min_price = price_map|min %} {%- set ns = namespace()  %} {%- set
        ns.min = 99  %} {%- set ns.max = 0  %}\n{%- for t in range (9,-1,-1) %}\n
        \ {%- if price_map[t] <= min_price * 1.1 %}\n    {%- set ns.min = t if ns.min
        > t %}\n    {%- if (ns.max < t) %}\n      {% set ns.max = t %}\n    {% endif
        %}\n  {%- endif %}\n{%- endfor %}\n{%- set ns.max = ns.max + 1  %} {% set
        ts_start = as_timestamp(now().replace(hour=22,minute=0,second=0)+timedelta(hours=ns.min))
        %} {% set ts_stop = as_timestamp(now().replace(hour=22,minute=0,second=0)+timedelta(hours=ns.max))
        %} {%- set current = states('input_text.automation_low_cost_coopernico') %}
        {{ current + \"|\" + ts_start|int|string + \"|\" + ts_stop|int|string}}\n"
    action: input_text.set_value
    enabled: false
  - target:
      entity_id:
      - input_datetime.night_water_heating_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[0]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.night_water_heating_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[0]
        | int + 3600*2 }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.late_afternoon_water_heating_start
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.late_afternoon_water_heating_stop
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int + 3600*2}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_ev_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_ev2_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_ev_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int + 3600*5}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_ev2_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[2]
        | int + 3600*5}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_cheap_ev_charge_start
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int }}        \n"
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_cheap_ev2_charge_start
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int }}        \n"
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.automation_cheap_ev_charge_stop
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int + 3600*1}}            \n"
    action: input_datetime.set_datetime
  - target:
      entity_id: input_datetime.automation_cheap_ev2_charge_stop
    data:
      timestamp: "{{ states('input_text.automation_low_cost_coopernico').split('|')[3]
        | int + 3600*1}}            \n"
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[1]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[1]
        | int + 3600*3}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_day_charge_start
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_day_charge_stop
    data:
      timestamp: '{{ states(''input_text.automation_afternoon_low_cost_coopernico'').split(''|'')[0]
        | int + 3600*2}}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_cheap_start
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[4]
        }}

        '
    action: input_datetime.set_datetime
  - target:
      entity_id:
      - input_datetime.solax_night_charge_cheap_stop
    data:
      timestamp: '{{ states(''input_text.automation_low_cost_coopernico'').split(''|'')[5]
        }}

        '
    action: input_datetime.set_datetime
  mode: single
- id: '1709761672379'
  alias: BMW CE Automation
  description: ''
  triggers:
  - at: input_datetime.automation_ev_charge_start
    id: EV start charging
    trigger: time
  - at: input_datetime.automation_ev_charge_stop
    id: EV stop charging
    enabled: true
    trigger: time
  - at: input_datetime.automation_cheap_ev_charge_start
    id: Cheap EV start charging
    trigger: time
  - at: input_datetime.automation_cheap_ev_charge_stop
    id: Cheap EV stop charging
    trigger: time
  conditions: []
  actions:
  - alias: Check if it's a long charging night
    if:
    - condition: and
      conditions:
      - condition: trigger
        id:
        - EV start charging
        - EV stop charging
      - alias: Checks if it's a long charging night
        condition: or
        conditions:
        - alias: Check if its monday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 0 and
            states(''input_boolean.home_office_monday'') == ''off'' else false }}'
        - alias: Check if its tuesday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 1 and
            states(''input_boolean.home_office_tuesday'') == ''off'' else false }}'
        - alias: Check if its wednesday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 2 and
            states(''input_boolean.home_office_wednesday'') == ''off'' else false
            }}'
        - alias: Check if its thursday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 3 and
            states(''input_boolean.home_office_thursday'') == ''off'' else false }}'
        - alias: Check if its Friday and it's a work day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 4 and
            states(''input_boolean.home_office_friday'') == ''off'' else false }}'
    then:
    - alias: Check if EV charge should start or stop
      if:
      - condition: trigger
        id:
        - EV start charging
      then:
      - alias: Set carging current to 6A if higher
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_charging_current
          above: 6
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 6
      - target:
          entity_id:
          - input_boolean.automatic_ve_switch
        data: {}
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 1
          seconds: 0
          milliseconds: 0
      else:
      - alias: Check if EV charge should Stop
        if:
        - condition: trigger
          id:
          - EV stop charging
        then:
        - target:
            entity_id:
            - input_boolean.automatic_ve_switch
          data: {}
          action: input_boolean.turn_off
  - alias: Check if it's a short charging night
    if:
    - condition: and
      conditions:
      - condition: trigger
        id:
        - Cheap EV start charging
        - Cheap EV stop charging
      - alias: Checks if it's a short charging night
        condition: or
        conditions:
        - alias: Check if its monday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 0 and
            states(''input_boolean.home_office_monday'') == ''on'' else false }}'
        - alias: Check if its tuesday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 1 and
            states(''input_boolean.home_office_tuesday'') == ''on'' else false }}'
        - alias: Check if its wednesday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 2 and
            states(''input_boolean.home_office_wednesday'') == ''on'' else false }}'
        - alias: Check if its thursday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 3 and
            states(''input_boolean.home_office_thursday'') == ''on'' else false }}'
        - alias: Check if its Friday and it's a home office day
          condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 4 and
            states(''input_boolean.home_office_friday'') == ''on'' else false }}'
        - condition: template
          value_template: '{{ true if (now()+timedelta(hours=12)).weekday() == 5 or
            (now()+timedelta(hours=12)).weekday() == 6 else false }}'
          alias: Check if it's the weekend
    then:
    - alias: Check if EV charge should start or stop
      if:
      - condition: trigger
        id:
        - Cheap EV start charging
      then:
      - alias: Set carging current to 6A if higher
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_charging_current
          above: 6
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 6
      - target:
          entity_id: input_boolean.automatic_ve_switch
        data: {}
        action: input_boolean.turn_on
      - delay:
          hours: 0
          minutes: 1
          seconds: 0
          milliseconds: 0
      else:
      - alias: Check if EV charge should Stop
        if:
        - condition: trigger
          id:
          - Cheap EV stop charging
        then:
        - target:
            entity_id: input_boolean.automatic_ve_switch
          data: {}
          action: input_boolean.turn_off
  - if:
    - condition: trigger
      id:
      - battery soc above 97
      - battery soc below 97
    - condition: numeric_state
      entity_id: sensor.solax_local_pv_output
      above: 100
    then:
    - choose:
      - conditions:
        - condition: trigger
          id:
          - battery soc above 97
        sequence:
        - metadata: {}
          data: {}
          target:
            entity_id: switch.tomada_ve
          action: switch.turn_on
      - conditions:
        - condition: trigger
          id:
          - battery soc below 97
        sequence:
        - target:
            entity_id:
            - switch.tomada_ve
          data: {}
          action: switch.turn_off
    alias: Checks if the battery is heavily charged and it's sunny
    enabled: false
  mode: queued
  max: 10
- id: '1709911987377'
  alias: SOLAX Automations
  description: ''
  triggers:
  - entity_id:
    - input_number.new_battery_target
    - input_number.new_day_battery_target
    id: new bat target
    trigger: state
  - at: input_datetime.solax_night_charge_start
    trigger: time
  - at: input_datetime.solax_night_charge_stop
    trigger: time
  - at: input_datetime.solax_night_charge_cheap_stop
    trigger: time
  - at: '21:30:00'
    id: Time to update battery charge
    trigger: time
  - at: input_datetime.solax_cheap_night_start
    id: set night soc
    trigger: time
  - at: input_datetime.solax_day_charge_start
    id: set day soc
    trigger: time
  - at: input_datetime.solax_day_charge_stop
    trigger: time
  - entity_id:
    - sensor.solax_local_battery_soc
    below: input_number.new_battery_target
    enabled: true
    trigger: numeric_state
  - entity_id:
    - sensor.solax_local_battery_soc
    below: input_number.new_day_battery_target
    enabled: true
    trigger: numeric_state
  - entity_id:
    - sensor.solax_local_battery_soc
    enabled: false
    trigger: state
  - entity_id:
    - sensor.solax_local_battery_soc
    enabled: true
    trigger: numeric_state
    for:
      hours: 0
      minutes: 0
      seconds: 10
    above: 94
    id: Battery full
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Time to update battery charge
        enabled: true
      sequence:
      - data_template:
          entity_id: input_text.solar_calculations
          value: "{%- set average_energy = 0.65 %} {%- set forecast_today = state_attr('sensor.solcast_pv_forecast_forecast_tomorrow',
            'detailedHourly') %}\n{# 1. Seasonality & Pricing #} {%- set is_winter
            = now().month >= 10 or now().month <= 4 %}\n{%- set night_price = states('input_text.automation_low_cost_coopernico').split('|')[6]
            | int %} {%- set afternoon_price = states('input_text.automation_afternoon_low_cost_coopernico').split('|')[1]
            | int %}\n{# 2. Hysteresis Logic (10%) #} {# Only prioritize the Afternoon
            if it is at least 10% cheaper than Night. #} {# Otherwise, default to
            Night to ensure the battery is ready earlier. #} {%- set afternoon_is_better
            = afternoon_price < (night_price * 0.9) %}\n{%- set night_stop = [states('input_datetime.solax_night_charge_stop'),
            states('input_datetime.solax_night_charge_cheap_stop')] \n    | map('as_timestamp')
            | max %}\n{%- set afternoon_stop = as_timestamp(states('input_datetime.solax_day_charge_stop'))
            %}\n{# 3. Strategy & Seasonal Offsets #} {%- if afternoon_is_better %}\n
            \ {%- set ts_full_start, ts_bare_start = afternoon_stop, night_stop %}\n
            \ {%- set f_offset, b_offset = (2, 1) if is_winter else (1, 0) %}\n{%-
            else %}\n  {%- set ts_full_start, ts_bare_start = night_stop, afternoon_stop
            %}\n  {%- set f_offset, b_offset = (3, 2) if is_winter else (1, 0) %}\n{%-
            endif %}\n{# 4. Simulate Full Charge Window with Solarsafe Forecasting
            #} {%- set full = namespace(max=0, min=0, batt_kw=0) %} {%- for r in forecast_today
            if as_timestamp(r.period_start) >= ts_full_start %}\n  {# Formula: (Estimate
            * 0.8) + (WorstCase * 0.2) #}\n  {%- set pv_est = r.pv_estimate | float(0)
            %}\n  {%- set pv_low = r.pv_estimate10 | default(pv_est) | float(0) %}\n
            \ {%- set pv_safe = (pv_est * 0.8) + (pv_low * 0.2) %}\n  \n  {%- set
            full.batt_kw = full.batt_kw + pv_safe - average_energy %}\n  {%- set full.max
            = [full.max, full.batt_kw] | max %}\n  {%- set full.min = [full.min, full.batt_kw]
            | min %}\n{%- endfor %}\n{# Logic for Full Target kWh #} {%- if (full.max
            - full.min) < (10 + f_offset) %}\n  {%- set TargetFullKW = [(10 + f_offset)
            - full.max, 10] | min %}\n{%- else %}\n  {%- set TargetFullKW = (0 - full.min)
            if full.min < 0 else 0 %}\n  {%- if full.min < -10 %}{%- set TargetFullKW
            = 10 %}{% endif %}\n{%- endif %}\n{# 5. Simulate Bare Charge Window with
            Solarsafe Forecasting #} {%- set bare = namespace(max=0, min=0, batt_kw=-b_offset)
            %} {%- for r in forecast_today if as_timestamp(r.period_start) >= ts_bare_start
            %}\n  {%- set ts = as_timestamp(r.period_start) %}\n  {%- if (ts_bare_start
            < ts_full_start and ts <= ts_full_start) or ts_bare_start > ts_full_start
            %}\n    {%- set pv_est = r.pv_estimate | float(0) %}\n    {%- set pv_low
            = r.pv_estimate10 | default(pv_est) | float(0) %}\n    {%- set pv_safe
            = (pv_est * 0.8) + (pv_low * 0.2) %}\n    \n    {%- set bare.batt_kw =
            bare.batt_kw + pv_safe - average_energy %}\n    {%- set bare.max = [bare.max,
            bare.batt_kw] | max %}\n  {%- endif %}\n  {%- set bare.min = [bare.min,
            bare.batt_kw] | min %}\n{%- endfor %}\n{%- set TargetBareKW = [[(0 - bare.min),
            0] | max, 9] | min %}\n{# 6. Apply 10% Efficiency Loss to Grid Charging
            #} {%- set TargetFullKW = TargetFullKW * 1.1 %} {%- set TargetBareKW =
            TargetBareKW * 1.1 %}\n{# 7. Conversion to Percentage and Final Selection
            #} {%- set pct_full = (TargetFullKW * 8.9 + 11) | round(0) %} {%- set
            pct_bare = (TargetBareKW * 8.9 + 11) | round(0) %}\n{%- if afternoon_is_better
            %}\n  {%- set batt_night, batt_afternoon = pct_bare, [pct_full, 90] |
            min %}\n{%- else %}\n  {%- set batt_night, batt_afternoon = pct_full,
            [pct_bare, 90] | min %}\n{%- endif %}\n{# 8. Final Output #} {{ batt_night
            | int }}|{{ batt_afternoon | int }}|{{ full.max | round(3) }}|{{ full.min
            | round(3) }}|{{ TargetBareKW | round(3) }}|{{ (full.max - full.min -
            10) | round(3) }}\n"
        enabled: true
        action: input_text.set_value
      - target:
          entity_id:
          - input_number.new_battery_target
        data:
          value: '{{ states(''input_text.solar_calculations'').split(''|'')[0] | int
            }}

            '
        enabled: true
        action: input_number.set_value
      - target:
          entity_id:
          - input_number.new_day_battery_target
        data:
          value: '{{ states(''input_text.solar_calculations'').split(''|'')[1] | int
            }}

            '
        enabled: true
        action: input_number.set_value
    - conditions:
      - condition: trigger
        id: ''
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to battery target
        if:
        - alias: Test if min SOC is equal to target SOC
          condition: template
          value_template: '{{ states(''sensor.solax_local_battery_min_soc'') | int
            != states(''input_number.new_battery_target'') | int }}'
        then:
        - alias: 'Set minimum soc charge '
          repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_battery_target'') }}'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_min_soc'')
                  | int == states(''input_number.new_battery_target'' ) | int }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
      alias: Stop discharge at night
    - conditions:
      - condition: trigger
        id: ''
        enabled: true
      sequence:
      - alias: checks and sets minimum SOC to battery target
        if:
        - alias: Test if min SOC is equal to target SOC
          condition: template
          value_template: '{{ states(''sensor.solax_local_battery_min_soc'') | int
            != states(''input_number.new_day_battery_target'')|int }}'
        then:
        - alias: 'Set minimum soc charge '
          repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_day_battery_target'')|int }}'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_min_soc'')
                  | int == states(''input_number.new_day_battery_target'')|int  }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
      alias: Stop discharge at day
  - choose:
    - conditions:
      - condition: time
        after: input_datetime.solax_night_charge_start
        before: input_datetime.solax_night_charge_stop
        alias: It's night charging time
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: input_number.new_battery_target
      sequence:
      - alias: Checks and sets battery charge target
        if:
        - condition: template
          value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
            int (60) !=  states(''input_number.new_battery_target'')| int (60) }}'
          alias: Check if battery target is uptodate
        then:
        - repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_battery_target'') | int (60)
                  }}'
              action: rest_command.solax_local_set_charge_battery_from_grid
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
                  int (60)  ==  states(''input_number.new_battery_target'')| int (60)
                  }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set new charging battery target
      - alias: Checks and sets battery charge start
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: '22:00'
        then:
        - alias: Set Charging start time
          repeat:
            sequence:
            - data:
                value: '{{ 22 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: '22:00'
      alias: Start Battery night charging
    - conditions:
      - condition: and
        conditions:
        - condition: template
          value_template: '{{ now() > states(''input_datetime.solax_night_charge_cheap_stop'')
            | as_datetime | as_local }}'
          alias: It's after cheap charging time
          enabled: true
        - condition: template
          value_template: '{{ now() > states(''input_datetime.solax_night_charge_stop'')
            | as_datetime | as_local }}'
          alias: It's after normal charging time
        - alias: It's before day charging time
          condition: template
          value_template: '{{ now() < states(''input_datetime.solax_day_charge_start'')
            | as_datetime | as_local }}'
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_min_soc
          above: 11
        then:
        - repeat:
            sequence:
            - data:
                level: '11'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: numeric_state
                entity_id: sensor.solax_local_battery_min_soc
                below: 12
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set minimum charge to 11
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: 08:00
        then:
        - alias: disable charging
          repeat:
            sequence:
            - data:
                value: '{{ 8 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: 08:00
      alias: Stop Battery night charging
    - conditions:
      - condition: time
        after: input_datetime.solax_day_charge_start
        before: input_datetime.solax_day_charge_stop
        alias: It's day charging time
      - condition: numeric_state
        entity_id: sensor.solax_local_battery_soc
        below: input_number.new_day_battery_target
      sequence:
      - alias: Checks and sets battery charge target
        if:
        - condition: template
          value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
            int (60) !=  states(''input_number.new_day_battery_target'')| int (60)
            }}'
          alias: Check if battery target is uptodate
        then:
        - repeat:
            sequence:
            - data:
                level: '{{ states(''input_number.new_day_battery_target'') | int (60)
                  }}'
              action: rest_command.solax_local_set_charge_battery_from_grid
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ states(''sensor.solax_local_battery_charge_from_grid_to'')|
                  int (60)  ==  states(''input_number.new_day_battery_target'')| int
                  (60) }}'
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set new charging battery target
      - alias: Checks and sets battery charge start
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: '10:00'
        then:
        - alias: Set Charging start time
          repeat:
            sequence:
            - data:
                value: '{{ 10 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: '22:00'
      alias: Start Battery day charging
    - conditions:
      - condition: template
        value_template: '{{ now() > states(''input_datetime.solax_day_charge_stop'')
          | as_datetime | as_local }}'
        alias: It's after day charging time
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_min_soc
          above: 11
        then:
        - repeat:
            sequence:
            - data:
                level: '11'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: numeric_state
                entity_id: sensor.solax_local_battery_min_soc
                below: 12
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set minimum charge to 11
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: 08:00
        then:
        - alias: disable charging
          repeat:
            sequence:
            - data:
                value: '{{ 8 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: 08:00
      alias: Stop Battery day charging
    - conditions:
      - condition: time
        after: input_datetime.solax_day_charge_start
        before: input_datetime.solax_day_charge_stop
        alias: It's day charging time
      - condition: trigger
        id:
        - Battery full
      sequence:
      - alias: checks and sets minimum SOC to 11
        if:
        - condition: numeric_state
          entity_id: sensor.solax_local_battery_min_soc
          above: 11
        then:
        - repeat:
            sequence:
            - data:
                level: '11'
              action: rest_command.solax_local_set_battery_min_soc
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: numeric_state
                entity_id: sensor.solax_local_battery_min_soc
                below: 12
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
          alias: Set minimum charge to 11
      - alias: Checks if Night stop charge is set to 8:00
        if:
        - condition: not
          conditions:
          - condition: state
            entity_id: sensor.solax_local_battery_setting_start_charge
            state: 08:00
        then:
        - alias: disable charging
          repeat:
            sequence:
            - data:
                value: '{{ 8 + 0 * 256 }}

                  '
              action: rest_command.solax_local_set_forced_charge_start
            - delay:
                hours: 0
                minutes: 0
                seconds: 22
                milliseconds: 0
            - data: {}
              target:
                entity_id: sensor.solax_rest_local_settings
              action: homeassistant.update_entity
            - delay:
                hours: 0
                minutes: 0
                seconds: 33
                milliseconds: 0
            until:
            - condition: or
              conditions:
              - condition: template
                value_template: '{{ repeat.index > 3 }}'
              - condition: state
                entity_id: sensor.solax_local_battery_setting_start_charge
                state: 08:00
      alias: Stop Battery day charging if battery full
  mode: queued
  max: 10
- id: '1710625524216'
  alias: Water Heater Automatic Mode
  description: ''
  triggers:
  - entity_id:
    - input_boolean.manual_override_aqs_switch
    - input_boolean.automatic_aqs_switch
    - input_boolean.grid_injection_avoidance_aqs_switch
    - switch.sonoff_1001dabf03
    id: AQS Switch changed state
    trigger: state
  conditions: []
  actions:
  - if:
    - condition: or
      conditions:
      - condition: state
        entity_id: input_boolean.manual_override_aqs_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.automatic_aqs_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.grid_injection_avoidance_aqs_switch
        state: 'on'
    then:
    - type: turn_on
      device_id: ab1489d8035b93fc65582524dac576aa
      entity_id: c5b8fcf3c5ab9b95ba7d5231106d98a3
      domain: switch
    else:
    - type: turn_off
      device_id: ab1489d8035b93fc65582524dac576aa
      entity_id: c5b8fcf3c5ab9b95ba7d5231106d98a3
      domain: switch
  - if:
    - condition: numeric_state
      entity_id: sensor.sonoff_1001dabf03_temperature
      above: 65
    then:
    - action: input_datetime.set_datetime
      metadata: {}
      data:
        timestamp: '{{ now().timestamp() }}'
      target:
        entity_id: input_datetime.last_high_water_temp
  mode: queued
  max: 10
- id: '1710687693819'
  alias: SOLAX Grid Injection control
  description: ''
  triggers:
  - alias: Turn ON Level 4 (Living Room AC & AQS)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float >= states(''sensor.solar_dump_base_target'')|float
      + 6 }}'
    id: Trigger Level Four
    for:
      seconds: 15
    trigger: template
  - alias: Turn ON Level 3 (Rooms AC)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float >= states(''sensor.solar_dump_base_target'')|float
      + 4 }}'
    id: Trigger Level Three
    for:
      seconds: 15
    trigger: template
  - alias: Turn ON Level 2 (EV + AQS)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float >= states(''sensor.solar_dump_base_target'')|float
      + 2 }}'
    id: Trigger Level Two
    for:
      seconds: 15
    trigger: template
  - alias: Turn ON Level 1 (EV or AQS)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float >= states(''sensor.solar_dump_base_target'')|float
      }}'
    id: Trigger Level One
    for:
      seconds: 15
    trigger: template
  - alias: Turn OFF Level 3 & 4 (Living Room & Rooms AC)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float < states(''sensor.solar_dump_base_target'')|float
      + 3 }}'
    id: Disable Level Three and Four
    for:
      seconds: 15
    trigger: template
  - alias: Turn OFF Level 2 (Downgrade to Level 1)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float < states(''sensor.solar_dump_base_target'')|float
      + 1 }}'
    id: Disable Level Two
    for:
      seconds: 15
    trigger: template
  - alias: Turn OFF Level 1 (Stop all dumping)
    value_template: '{{ states(''sensor.solax_local_battery_soc'')|float < states(''sensor.solar_dump_base_target'')|float
      - 1 }}'
    id: Disable Level One
    for:
      seconds: 15
    trigger: template
  - alias: AQS Water Temperature Reached Target
    entity_id: sensor.sonoff_1001dabf03_temperature
    id: Water Temperature reached target
    above: input_number.water_heater_dinner_target
    value_template: '{{ float(state.state) + 5 }}'
    for:
      seconds: 15
    trigger: numeric_state
  conditions:
  - condition: numeric_state
    entity_id: sensor.solax_local_battery_soc
    above: 80
    enabled: false
  - condition: or
    alias: Require sun for Turn-ONs, but allow Turn-OFFs anytime
    conditions:
    - condition: sun
      before: sunset
      after: sunrise
    - condition: template
      value_template: '{{ trigger.id in [''Disable Level Three and Four'', ''Disable
        Level Two'', ''Disable Level One''] }}'
  - condition: template
    alias: Prevent Yo-Yo Drain at 99% but allow Turn-Offs
    value_template: "{% set avg_solar = states('sensor.solar_power_5_min_average')
      | float(0) %} {% set soc = states('sensor.solax_local_battery_soc') | float(0)
      %}\n{# Identify if the automation was triggered by one of the Turn ON commands
      #} {% set is_turn_on_trigger = trigger.id in ['Trigger Level One', 'Trigger
      Level Two', 'Trigger Level Three', 'Trigger Level Four', 'Water Temperature
      reached target'] %}\n{# If trying to turn ON a load, solar is dead (<650W),
      AND battery is >98%... SKIP IT #} {% if is_turn_on_trigger and avg_solar < 650
      and soc > 98 %}\n  false\n  \n{# Otherwise, let the automation run normally
      #} {% else %}\n  true\n{% endif %}\n"
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Trigger Level One
      sequence:
      - if:
        - condition: numeric_state
          entity_id: sensor.sonoff_1001dabf03_temperature
          above: input_number.water_heater_dinner_target
          value_template: '{{ float (state.state) - 2 }}'
        then:
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_aqs_switch
          action: input_boolean.turn_off
        - alias: Set carging current to 10A if lower
          if:
          - condition: numeric_state
            entity_id: number.ev_charger_charging_current
            below: 10
          then:
          - device_id: b673bb9bf4da0c5ee75c1581175ca268
            domain: number
            entity_id: e8d2960d523eed419247a39daf9c38fb
            type: set_value
            value: 10
          enabled: false
        - delay:
            hours: 0
            minutes: 0
            seconds: 1
            milliseconds: 0
          enabled: false
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_ve_switch
          action: input_boolean.turn_on
          enabled: false
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_ve2_switch
          action: input_boolean.turn_on
          enabled: false
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_ve_s
          action: input_boolean.turn_on
          enabled: true
        - action: automation.trigger
          metadata: {}
          target:
            entity_id: automation.decide_witch_ev_to_charge_first
          data:
            skip_condition: true
        else:
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_aqs_switch
          action: input_boolean.turn_on
    - conditions:
      - condition: trigger
        id:
        - Trigger Level Two
      sequence:
      - alias: Set charging current to 10A if lower
        if:
        - condition: numeric_state
          entity_id: number.ev_charger_charging_current
          below: 10
        then:
        - device_id: b673bb9bf4da0c5ee75c1581175ca268
          domain: number
          entity_id: e8d2960d523eed419247a39daf9c38fb
          type: set_value
          value: 10
        enabled: false
      - delay:
          hours: 0
          minutes: 0
          seconds: 1
          milliseconds: 0
        enabled: false
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve_switch
        action: input_boolean.turn_on
        enabled: false
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve2_switch
        action: input_boolean.turn_on
        enabled: false
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
        action: input_boolean.turn_on
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_ve_s
        action: input_boolean.turn_on
        enabled: true
      - action: automation.trigger
        metadata: {}
        target:
          entity_id: automation.decide_witch_ev_to_charge_first
        data:
          skip_condition: true
        enabled: true
    - conditions:
      - condition: trigger
        id:
        - Trigger Level Three
      sequence:
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.automation_start_rooms_ac
        action: input_boolean.turn_on
    - conditions:
      - condition: trigger
        id:
        - Trigger Level Four
      sequence:
      - metadata: {}
        data: {}
        target:
          entity_id:
          - input_boolean.automation_start_livingroom_ac
        action: input_boolean.turn_on
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
        action: input_boolean.turn_on
    - conditions:
      - condition: trigger
        id:
        - Disable Level Three and Four
      sequence:
      - data: {}
        target:
          entity_id:
          - input_boolean.automation_start_livingroom_ac
          - input_boolean.automation_start_rooms_ac
        action: input_boolean.turn_off
      - target:
          entity_id:
          - input_boolean.grid_injection_avoidance_aqs_switch
        data: {}
        action: input_boolean.turn_off
        enabled: false
    - conditions:
      - condition: trigger
        id:
        - Disable Level Two
      sequence:
      - if:
        - condition: numeric_state
          entity_id: sensor.sonoff_1001dabf03_temperature
          above: input_number.water_heater_dinner_target
          value_template: '{{ float (state.state) - 2 }}'
        then:
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_aqs_switch
          action: input_boolean.turn_off
        else:
        - target:
            entity_id:
            - input_boolean.grid_injection_avoidance_ve2_switch
            - input_boolean.grid_injection_avoidance_ve_s
            - input_boolean.grid_injection_avoidance_ve_switch
          data: {}
          action: input_boolean.turn_off
    - conditions:
      - condition: trigger
        id:
        - Disable Level One
      sequence:
      - metadata: {}
        data: {}
        target:
          entity_id: input_boolean.grid_injection_avoidance_aqs_switch
        action: input_boolean.turn_off
      - target:
          entity_id:
          - input_boolean.grid_injection_avoidance_ve2_switch
          - input_boolean.grid_injection_avoidance_ve_s
          - input_boolean.grid_injection_avoidance_ve_switch
        data: {}
        action: input_boolean.turn_off
    - conditions:
      - condition: trigger
        id:
        - Water Temperature reached target
      sequence:
      - if:
        - condition: and
          conditions:
          - condition: state
            entity_id: input_boolean.grid_injection_avoidance_ve_s
            state:
            - 'off'
          - condition: state
            entity_id: input_boolean.grid_injection_avoidance_aqs_switch
            state: 'on'
        then:
        - target:
            entity_id:
            - input_boolean.grid_injection_avoidance_aqs_switch
          data: {}
          action: input_boolean.turn_off
        - metadata: {}
          data: {}
          target:
            entity_id: input_boolean.grid_injection_avoidance_ve_s
          action: input_boolean.turn_on
          enabled: true
        - action: automation.trigger
          metadata: {}
          target:
            entity_id: automation.decide_witch_ev_to_charge_first
          data:
            skip_condition: true
        else: []
  mode: queued
  max: 3
- id: '1710690337460'
  alias: VE Automatic Mode
  description: ''
  triggers:
  - entity_id:
    - input_boolean.manual_override_ve_switch
    - input_boolean.automatic_ve_switch
    - input_boolean.grid_injection_avoidance_ve_switch
    id: VE Switch changed state
    trigger: state
  - entity_id:
    - sensor.box_ve1_power
    below: 500
    id: VE_power_zero
    for:
      hours: 0
      minutes: 5
      seconds: 0
    trigger: numeric_state
    enabled: false
  - entity_id:
    - timer.cooldown_evcharger
    from: active
    to: idle
    trigger: state
  - trigger: template
    value_template: '{{ states(''sensor.ev_charger_status'') == ''waiting'' }}'
    id: EV charger waiting
  - type: changed_states
    device_id: b673bb9bf4da0c5ee75c1581175ca268
    entity_id: 7372628f0279bcfe038a1a021ffc05e5
    domain: switch
    trigger: device
  conditions: []
  actions:
  - if:
    - condition: state
      entity_id: input_boolean.manual_override_ve_switch
      state: 'on'
    then:
    - alias: Set BMW charging current to 6A if higher
      if:
      - condition: numeric_state
        entity_id: number.ev_charger_charging_current
        above: 6
      then:
      - device_id: b673bb9bf4da0c5ee75c1581175ca268
        domain: number
        entity_id: e8d2960d523eed419247a39daf9c38fb
        type: set_value
        value: 6
      enabled: true
  - if:
    - condition: or
      conditions:
      - condition: state
        entity_id: input_boolean.manual_override_ve_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.automatic_ve_switch
        state: 'on'
      - condition: state
        entity_id: input_boolean.grid_injection_avoidance_ve_switch
        state: 'on'
    then:
    - if:
      - condition: device
        type: is_off
        device_id: b673bb9bf4da0c5ee75c1581175ca268
        entity_id: 7372628f0279bcfe038a1a021ffc05e5
        domain: switch
      then:
      - action: switch.turn_on
        metadata: {}
        data: {}
        target:
          entity_id: switch.ev_charger
      else:
      - if:
        - condition: trigger
          id:
          - VE_power_zero
        then:
        - type: turn_off
          device_id: cb0512f084dfe73bb627d29df25f74c4
          entity_id: 773bc18359c530b24d91098ccc9f8413
          domain: switch
        - metadata: {}
          data:
            duration: 00:01:00
          target:
            entity_id: timer.cooldown_evcharger
          action: timer.start
        enabled: false
      - if:
        - condition: trigger
          id:
          - EV charger waiting
        then:
        - type: turn_off
          device_id: cb0512f084dfe73bb627d29df25f74c4
          entity_id: 773bc18359c530b24d91098ccc9f8413
          domain: switch
        - delay:
            hours: 0
            minutes: 0
            seconds: 5
            milliseconds: 0
        - type: turn_on
          device_id: cb0512f084dfe73bb627d29df25f74c4
          entity_id: 773bc18359c530b24d91098ccc9f8413
          domain: switch
    else:
    - type: turn_off
      device_id: b673bb9bf4da0c5ee75c1581175ca268
      entity_id: 7372628f0279bcfe038a1a021ffc05e5
      domain: switch
  - delay:
      hours: 0
      minutes: 0
      seconds: 5
      milliseconds: 0
  mode: queued
  max: 10
- id: '1711213074704'
  alias: Auto Backup
  description: ''
  trigger:
  - platform: time
    at: '23:00:00'
  condition: []
  action:
  - if:
    - condition: template
      value_template: '{{ true if now().weekday() == 0 else false }}'
      alias: Test if its monday
    then:
    - service: auto_backup.backup_full
      data:
        compressed: true
        exclude: {}
        keep_days: 31
    else:
    - service: auto_backup.backup_full
      data:
        compressed: true
        keep_days: 7
  mode: single
- id: '1711276188208'
  alias: keep Energy sensors working
  description: ''
  triggers:
  - entity_id:
    - switch.tomada_frigorifrico
    - switch.tomada_arca_frigorifrica
    - switch.tomada_maquina_lavar_loica
    - switch.tomada_maquina_lavar_roupa
    - switch.tomada_aqs
    - switch.tomada_dryer
    to:
    - 'off'
    from:
    trigger: state
  - event: start
    trigger: homeassistant
  - hours: '*'
    minutes: '*'
    seconds: '45'
    trigger: time_pattern
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: state
        entity_id: switch.tomada_frigorifrico
        state: 'off'
      sequence:
      - type: turn_on
        device_id: 1d616a1070cd5de2b442aed6588db51e
        entity_id: 552c277fcffa4fce02c73c98c0ae16bf
        domain: switch
    - conditions:
      - condition: state
        entity_id: switch.tomada_arca_frigorifrica
        state: 'off'
      sequence:
      - type: turn_on
        device_id: 4dec60936acb4bbef9e2b375a4e8b28f
        entity_id: b6dcb4668672079413c54ec2aa7912c4
        domain: switch
    - conditions:
      - condition: state
        entity_id: switch.tomada_maquina_lavar_loica
        state: 'off'
      sequence:
      - type: turn_on
        device_id: 63deec099955e42c4b963076b83174aa
        entity_id: bb42e46e053b05a280e1b9fa00076025
        domain: switch
    - conditions:
      - condition: state
        entity_id: switch.tomada_maquina_lavar_roupa
        state: 'off'
      sequence:
      - type: turn_on
        device_id: ea3a34b017e9d4b3de169f07ee71939e
        entity_id: fc4d9e437a9a1906be4b6255b1004656
        domain: switch
    - conditions:
      - condition: state
        state: 'off'
        entity_id: switch.tomada_aqs
      sequence:
      - delay:
          hours: 0
          minutes: 0
          seconds: 5
          milliseconds: 0
      - type: turn_on
        device_id: 7542e24ccd5f2075c3c201d0cc7d386a
        entity_id: 9271b8040d40e47b460e20df6bda755c
        domain: switch
    - conditions:
      - condition: state
        state: 'off'
        entity_id: switch.tomada_dryer
      sequence:
      - type: turn_on
        device_id: cf5d9995e7ff451f61853b659597d5ae
        entity_id: ae49b207246c310f296b7b2017f1be05
        domain: switch
  mode: queued
  max: 10
- id: '1712705407698'
  alias: Dehumifier Automatic Mode
  description: ''
  triggers:
  - at: '12:00:00'
    id: Start dehumifiers
    trigger: time
  - at: '18:00:00'
    id: Stop dehumifiers
    trigger: time
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - Start dehumifiers
      sequence:
      - type: turn_on
        device_id: fc9d58e1e5a004d7e35b70772da9d0d9
        entity_id: f7aa2096d0884e6d500bd3bb19d4c75d
        domain: switch
      - type: turn_on
        device_id: 5faf8ee388b0fc335d764f6ca52433d0
