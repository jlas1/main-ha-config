- id: '1741296099297'
  alias: Automation for Blinds
  description: ''
  triggers:
  - trigger: numeric_state
    entity_id:
    - sun.sun
    attribute: elevation
    below: -0.1
    id: sun almost at sunset
  - trigger: numeric_state
    entity_id:
    - sun.sun
    attribute: elevation
    below: -6
    id: dark outside
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: trigger
        id:
        - sun almost at sunset
      sequence:
      - device_id: bb43907c1501cb3018305f76d7096938
        domain: cover
        entity_id: 311630ec4862b46014d6486f44c956af
        type: close
      - device_id: fef4c0ba58d41832b00cb28e74ba046d
        domain: cover
        entity_id: 60ef3f692f98e6751f38a19109c3f1b9
        type: close
      - device_id: 69cee409ac695099dde7ffb6559ab326
        domain: cover
        entity_id: 235a898412d0484c944a118c895ec839
        type: close
      - if:
        - type: is_open
          condition: device
          device_id: 23896d16d78177d9c9f3176d951a632d
          entity_id: da4eb86a9f17df10388508bf23e2e1e3
          domain: binary_sensor
        then:
        - wait_for_trigger:
          - type: not_opened
            device_id: 23896d16d78177d9c9f3176d951a632d
            entity_id: da4eb86a9f17df10388508bf23e2e1e3
            domain: binary_sensor
            trigger: device
            for:
              hours: 0
              minutes: 0
              seconds: 10
          timeout:
            hours: 1
            minutes: 0
            seconds: 0
            milliseconds: 0
      - device_id: 8b53305e4011ef82d24c0bb7a552c1db
        domain: cover
        entity_id: d8f5767a6784bd4c710ae5fcb60574b0
        type: close
    - conditions:
      - condition: trigger
        id:
        - dark outside
      sequence:
      - device_id: f03c7e63eca8edf0164dad71d8db4372
        domain: cover
        entity_id: 58e3417a5605a136a5f467f9c39a3599
        type: close
  mode: queued
  max: 10
