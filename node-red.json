    {
        "id": "282ec0d83d44b922",
        "type": "function",
        "z": "ea9f973fddd65ef1",
        "name": "action_execute_mode3_math_engine",
        "func": "const getNum = (key, fallback = 0) => {\n    const val = flow.get(key);\n    if (val === undefined || val === null || val === \"\") return fallback;\n    const parsed = parseFloat(val);\n    return isNaN(parsed) ? fallback : parsed;\n};\n\nconst solaxPowerRaw = flow.get(\"solax_battery_power\");\nconst gridImportRaw = flow.get(\"solax_grid_import\");\nconst gridExportRaw = flow.get(\"solax_grid_export\");\nconst solaxSocRaw = flow.get(\"solax_soc\");\nconst victronDcVoltageRaw = flow.get(\"victron_dc_voltage\");\nconst victronGridConsumptionRaw = flow.get(\"victron_grid_consumption_l1\");\n\nlet debug = \"\";\n\nif (solaxPowerRaw === undefined || gridImportRaw === undefined || gridExportRaw === undefined || \n    solaxSocRaw === undefined || victronDcVoltageRaw === undefined || victronGridConsumptionRaw === undefined)  {\n    node.status({ fill: \"yellow\", shape: \"ring\", text: \"Hydrating flow context...\" });\n    return null;\n}\n\nconst solaxBatteryPower = getNum(\"solax_battery_power\");\nconst victronBatteryPower = Math.round(getNum(\"victron_battery_power\"));\nconst gridImport = getNum(\"solax_grid_import\");\nconst gridExport = getNum(\"solax_grid_export\");\nconst victron_soc = getNum(\"victron_battery_soc\");\nconst solax_min_soc = getNum(\"solax_minimum_soc\",10);\nconst victron_min_soc = getNum(\"victron_minimum_soc\",20);\nconst victron_max = getNum(\"victron_max_battery_power\", 1000);\nconst netGridConsumption = gridImport - gridExport;\nconst victronGridConsumption = getNum(\"victron_grid_consumption_l1\");\n\nconst solaxSoc = getNum(\"solax_soc\");\nconst solarDumpTarget = getNum(\"solar_dump_base_target\", 75);\n\nconst itUpsLoad = getNum(\"it_ups_load\");\nconst victronDcVoltage = getNum(\"victron_dc_voltage\");\nconst currentVictronSetpoint = getNum(\"current_victron_setpoint\", 0);\nconst vebusState = getNum(\"vebus_state\", 0);\n\n// Solar Dump Hysteresis\nlet solarDumpActive = flow.get(\"solar_dump_active\") || false;\nif (solaxSoc >= solarDumpTarget) {\n    solarDumpActive = true;\n} else if (solaxSoc <= (solarDumpTarget - 0.5)) {\n    solarDumpActive = false;\n}\nflow.set(\"solar_dump_active\", solarDumpActive);\n\nlet surplus = victronBatteryPower + solaxBatteryPower - netGridConsumption;\n\n// Total physical capacities (in kWh)\nconst victronCapacity = 6.0;\nconst solaxCapacity = 11.6;\n\n// -----------------------------------------------------------------------------\n// 1. DISCHARGE CALCULATION (Energy Remaining)\n// -----------------------------------------------------------------------------\n// SolaX discharge power is negative. If >= -30W, SolaX is idle/sleeping/holding.\nconst solaxIsDischarging = solaxBatteryPower < -30;\n\n// Use Math.max(..., 0) so available capacity can actually hit 0\nconst victronDischargeAvailable = victronCapacity * Math.max(victron_soc - victron_min_soc, 0);\n\n// SolaX has available energy ONLY if it is above min_soc AND actively discharging\nconst solaxDischargeAvailable = (solaxSoc > solax_min_soc && solaxIsDischarging)\n    ? (solaxCapacity * Math.max(solaxSoc - solax_min_soc, 0))\n    : 0;\n\nconst totalDischargeAvailable = victronDischargeAvailable + solaxDischargeAvailable;\n\n// If SolaX cannot/will not discharge, Victron takes 100% (1.0). If both are empty, ratio is 0.\nconst dischargeRatio = totalDischargeAvailable > 0 \n    ? (victronDischargeAvailable / totalDischargeAvailable) \n    : (victron_soc > victron_min_soc ? 1.0 : 0.0);\n\n// -----------------------------------------------------------------------------\n// 2. CHARGE CALCULATION (Empty Space to Fill)\n// -----------------------------------------------------------------------------\nconst victronChargeSpace = victronCapacity * Math.max(100 - victron_soc, 0);\nconst solaxChargeSpace = solaxCapacity * Math.max(90 - solaxSoc, 0);\nconst totalChargeSpace = victronChargeSpace + solaxChargeSpace;\nconst chargeRatio = totalChargeSpace > 0 \n    ? (victronChargeSpace / totalChargeSpace) \n    : 0.5;\n\n// -----------------------------------------------------------------------------\n// 3. APPLY RATIO ACCORDING TO SURPLUS DIRECTION\n// -----------------------------------------------------------------------------\nlet ratio;\nlet status = \"target pelo consumo \";\n\nif (surplus >= 0) {\n    ratio = Math.round(chargeRatio * 100) / 100;\n} else {\n    ratio = Math.round(dischargeRatio * 100) / 100;\n    if (!solaxIsDischarging && solaxSoc > solax_min_soc) {\n        status = \"Solax 0W (compensacao Victron 100%) \";\n    }\n}\n\nlet rawTarget = Math.round(surplus * ratio);\n\n// Apply overrides to the RAW target before rate limiting\nif (rawTarget > itUpsLoad && solarDumpActive) {\n    rawTarget = surplus - 200;\n    status = \"Limitado pelo output AC\";\n}\n\nif (rawTarget < -victron_max) {\n    rawTarget = -victron_max;\n    status = `descarga máxima ${victron_max}`;\n}\n\n// RATE LIMITER (The Delta): Clamp change to max 300W in BOTH directions\nlet rawDelta = rawTarget - victronBatteryPower;\nlet delta = Math.max(Math.min(rawDelta, 300), -300);\nlet targetSetpoint = Math.round(victronBatteryPower + delta);\nlet isBlocked = false;\nlet blockReason = \"\";\n\nstatus = status + \" \" + targetSetpoint;\nlet finalSetpoint = targetSetpoint + itUpsLoad;\n\n// Force Charge Override (Bypasses normal limits intentionally)\nif (flow.get(\"force_battery_charge\") === \"on\") {\n    if (victron_soc <= flow.get(\"victron_battery_charge_level\")) {\n        finalSetpoint = 3000;\n        status = \"force charge\";\n    } else {\n        finalSetpoint = Math.max(itUpsLoad,finalSetpoint);\n        status = \"force charge paused\";\n    }\n} else { \n    \n    // Deadband Check\n    const deadbandDelta = Math.abs(finalSetpoint - currentVictronSetpoint);\n    if (deadbandDelta < 50) {\n        finalSetpoint = currentVictronSetpoint;\n        status = status + \" e diferenca menor que 50W\";\n    }\n    \n    // Safety / Cutoff Logic\n    let passthroughActive = flow.get(\"passthrough_active\") || false;\n    if (vebusState === 8) {\n        passthroughActive = true;\n    }\n    \n    if ((victronDcVoltage < 48.8) || (victron_soc <= 20) || (victron_soc <= victron_min_soc)) {\n        passthroughActive = true;\n        if (finalSetpoint < itUpsLoad) {\n            isBlocked = true;\n            blockReason = `Victron DC Voltage (${victronDcVoltage}V) < 48.8V cutoff. Discharge clamped.`;\n            finalSetpoint = itUpsLoad + 50;\n        }\n    } else if ((victronDcVoltage < 50.5) && (victron_soc < 25) && passthroughActive) {\n        if (finalSetpoint < itUpsLoad) {\n            isBlocked = true;\n            blockReason = `Victron DC Voltage (${victronDcVoltage}V) < 50.5V recovery. Discharge clamped.`;\n            finalSetpoint = itUpsLoad;\n        }\n    } else {\n        passthroughActive = false;\n    }\n    \n    //if (victron_soc <= victron_min_soc) {\n    //    finalSetpoint = itUpsLoad;\n    //    status = \"minimum SOC reached\"\n    //}\n\n    flow.set(\"passthrough_active\", passthroughActive);\n    \n}\n\n\nnode.status({\n    fill: isBlocked ? \"red\" : (finalSetpoint !== currentVictronSetpoint ? \"green\" : \"blue\"),\n    shape: \"dot\",\n    text: isBlocked ? `CLAMPED: ${blockReason}` : `SBP:${solaxBatteryPower} VBP:${victronBatteryPower} G:${netGridConsumption} U:${itUpsLoad} O:${finalSetpoint} R:${ratio} Reason: ${status} ${debug}`\n});\n\nlet hardwareMsg = null;\nlet safetyMsg = null;\nlet setpointMsg = null;\n\nif (isBlocked) {\n    // Safety Alert (Output 2) - Hardware output remains null\n    safetyMsg = {\n        payload: {\n            message: `[VICTRON_SAFETY_AUDIT] Dispatch blocked. ${blockReason} Active Setpoint: ${currentVictronSetpoint}W.`\n        }\n    };\n} else {\n    // Hardware Setpoint Command (Output 1)\n    hardwareMsg = { payload: finalSetpoint };\n\n    // Setpoint Audit Log (Output 3)\n    setpointMsg = {\n        payload: {\n            message: `[VICTRON_SETPOINT_AUDIT] Setpoint updated: ${currentVictronSetpoint}W -> ${finalSetpoint}W (Target: ${targetSetpoint}W).`\n        }\n    };\n}\n\nreturn [hardwareMsg, safetyMsg, setpointMsg];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\nflow.set(\"passthrough_active\", false);",
